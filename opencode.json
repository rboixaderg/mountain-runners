{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "development",
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "pnpm",
        "--dir",
        "tools/playwright-mcp",
        "--ignore-workspace",
        "exec",
        "playwright-mcp",
        "--isolated"
      ],
      "enabled": true
    },
    "plausible": {
      "type": "local",
      "command": ["node", "{env:PLAUSIBLE_MCP_ENTRYPOINT}"],
      "environment": {
        "PLAUSIBLE_API_KEY": "{env:PLAUSIBLE_API_KEY}",
        "PLAUSIBLE_BASE_URL": "{env:PLAUSIBLE_BASE_URL}"
      },
      "enabled": true
    }
  }
}
