# Google Stitch MCP access. Keep the actual key in the local environment only.
STITCH_API_KEY=

# Private development agent (phase 8, T8.3). Names only; the values live in the
# VPS secret store and never in the repository. See docs/deployment.md.
# MOUNTAIN_AGENT_TELEGRAM_BOT_TOKEN=
# MOUNTAIN_AGENT_TELEGRAM_GROUP_ID=
# MOUNTAIN_AGENT_TELEGRAM_BOT_USERNAME=
# MOUNTAIN_AGENT_GITHUB_TOKEN=
# MOUNTAIN_AGENT_REPOSITORY=rboixaderg/mountain-runners
# MOUNTAIN_AGENT_MODEL=opencode-go/glm-5.3-flash
# MOUNTAIN_AGENT_PROVIDER_ENVIRONMENT_VARIABLES=
# MOUNTAIN_AGENT_PI_COMMAND=pi
# MOUNTAIN_AGENT_SANDBOX_IMAGE=
# MOUNTAIN_AGENT_REPOSITORY_PATH=/var/lib/mountain-runners-agent/repository
# MOUNTAIN_AGENT_WORKTREE_PATH=/var/lib/mountain-runners-agent/worktrees
# MOUNTAIN_AGENT_SESSION_PATH=/var/lib/mountain-runners-agent/sessions
# MOUNTAIN_AGENT_STATE_PATH=/var/lib/mountain-runners-agent/state
