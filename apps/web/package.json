{
  "name": "@mountain-runners/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm paraglide:generate && astro build && node scripts/verify-i18n-output.mjs",
    "dev": "astro dev",
    "paraglide:generate": "node scripts/generate-paraglide.mjs",
    "paraglide:verify": "node scripts/verify-paraglide-generation.mjs",
    "test": "pnpm paraglide:generate && pnpm test:generated",
    "test:generated": "pnpm paraglide:verify && MR_PARAGLIDE_PREGENERATED=1 vitest run",
    "typecheck": "pnpm paraglide:generate && pnpm typecheck:generated",
    "typecheck:generated": "MR_PARAGLIDE_PREGENERATED=1 astro check"
  },
  "dependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/jsdom": "30.0.0",
    "@types/mdast": "4.0.4",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
