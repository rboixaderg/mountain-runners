---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PreFooter from "../components/PreFooter.astro";
import logoFavicon from "../assets/favicon-32.png";
import oswaldFont from "../assets/fonts/oswald-latin.woff2";
import { getPublicationCatalog } from "../lib/content/repository";
import { institutionalEntityId } from "../lib/content/members";
import { externalActionIds } from "../lib/content/models";
import { getOrderedPublishedSchoolVariants } from "../lib/content/schools";
import { getFixedPagePath } from "../lib/content/routes";
import { defaultLocale, type Locale } from "../lib/content/primitives";
import { getEntityLinkUrl } from "../lib/presentation/entities";
import { getMemberSignupLink } from "../lib/presentation/status";
import {
  openGraphLocales,
  renderJsonLdScript,
  type SocialImage,
  type StructuredData,
} from "../lib/content/seo";
import * as messages from "../paraglide/messages.js";
import "../styles/global.css";

type LocalizedAlternative = { locale: Locale; href: string };

interface Props {
  localizedAlternatives?: LocalizedAlternative[];
  canonical?: string;
  description: string;
  locale: Locale;
  noindex?: boolean;
  socialImage?: SocialImage;
  structuredData?: StructuredData[];
  title: string;
}

const {
  localizedAlternatives = [],
  canonical,
  description,
  locale,
  noindex = false,
  socialImage,
  structuredData = [],
  title,
} = Astro.props;
const defaultLocaleAlternative = localizedAlternatives.find(
  (alternative) => alternative.locale === defaultLocale,
);

const catalog = await getPublicationCatalog();
const institutionalEntity = catalog.entities.get(institutionalEntityId);
const institutionalLinks = institutionalEntity?.links ?? [];
// The layout prepares the domain data the shell consumes, so the header and
// footer stay presentation-only components.
const schoolVariants = getOrderedPublishedSchoolVariants(catalog, locale);
const memberSignupLink = getMemberSignupLink(
  catalog.externalActions.get(externalActionIds.memberSignup),
  locale,
  getFixedPagePath("members", locale),
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={logoFavicon.src} />
    <link
      rel="preload"
      href={oswaldFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      localizedAlternatives.map((alternative) => (
        <link
          rel="alternate"
          hreflang={alternative.locale}
          href={alternative.href}
        />
      ))
    }
    {
      defaultLocaleAlternative && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={defaultLocaleAlternative.href}
        />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      socialImage && (
        <>
          <meta property="og:image" content={socialImage.url} />
          <meta property="og:image:alt" content={socialImage.alt} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {
      structuredData.map((data) => (
        <Fragment set:html={renderJsonLdScript(data)} />
      ))
    }
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content"
      >{messages.skip_to_content({}, { locale })}</a
    >
    <SiteHeader
      localizedAlternatives={localizedAlternatives}
      locale={locale}
      memberSignupLink={memberSignupLink}
      schoolVariants={schoolVariants}
    />
    <main id="main-content"><slot /></main>
    <PreFooter catalog={catalog} locale={locale} />
    <SiteFooter
      instagramUrl={getEntityLinkUrl(institutionalLinks, "instagram")}
      locale={locale}
      stravaClubUrl={getEntityLinkUrl(institutionalLinks, "strava")}
    />
  </body>
</html>
