---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PreFooter from "../components/PreFooter.astro";
import logoFavicon from "../assets/logo_mountain_runners.png";
import oswaldFont from "../assets/fonts/oswald-latin.woff2";
import { getPublicationCatalog } from "../lib/content/repository";
import type { Locale } from "../lib/content/primitives";
import { renderJsonLdScript, type StructuredData } from "../lib/content/seo";
import * as messages from "../paraglide/messages.js";
import "../styles/global.css";

type LocalizedAlternative = { locale: Locale; href: string };

interface Props {
  localizedAlternatives?: LocalizedAlternative[];
  canonical?: string;
  description: string;
  locale: Locale;
  noindex?: boolean;
  structuredData?: StructuredData[];
  title: string;
}

const {
  localizedAlternatives = [],
  canonical,
  description,
  locale,
  noindex = false,
  structuredData = [],
  title,
} = Astro.props;

const catalog = await getPublicationCatalog();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={logoFavicon.src} />
    <link
      rel="preload"
      href={oswaldFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      localizedAlternatives.map((alternative) => (
        <link
          rel="alternate"
          hreflang={alternative.locale}
          href={alternative.href}
        />
      ))
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      structuredData.map((data) => (
        <Fragment set:html={renderJsonLdScript(data)} />
      ))
    }
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content"
      >{messages.skip_to_content({}, { locale })}</a
    >
    <SiteHeader
      catalog={catalog}
      localizedAlternatives={localizedAlternatives}
      locale={locale}
    />
    <main id="main-content"><slot /></main>
    <PreFooter catalog={catalog} locale={locale} />
    <SiteFooter locale={locale} />
  </body>
</html>
