---
import * as messages from "../paraglide/messages.js";
import { getDomainPath } from "../lib/content/routes";
import PublicLayout from "../layouts/PublicLayout.astro";

const locale = "ca";
const canonical = new URL("/404.html", Astro.site).toString();
---

<PublicLayout
  canonical={canonical}
  description={messages.not_found_description({}, { locale })}
  locale={locale}
  noindex={true}
  title={`${messages.not_found_title({}, { locale })} | ${messages.site_title()}`}
>
  <section class="page-frame max-w-reading py-section">
    <p class="font-display tracking-display m-0 text-lg uppercase">404</p>
    <h1 class="font-display text-display-home leading-display tracking-headline my-3 mb-6 uppercase">
      {messages.not_found_title({}, { locale })}
    </h1>
    <p class="text-lg leading-copy">
      {messages.not_found_description({}, { locale })}
    </p>
    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-4 font-bold">
      <a href="/ca/">{messages.back_to_home({}, { locale })}</a>
      <a href={getDomainPath("event", locale)}>
        {messages.not_found_events({}, { locale })}
      </a>
    </div>
    <details class="mt-10 border-t border-line pt-4 text-sm">
      <summary class="cursor-pointer font-bold">
        {messages.not_found_agent_resources({}, { locale })}
      </summary>
      <ul class="mt-4 mb-0 list-none space-y-2 p-0">
        <li>
          <a href="/llms.txt">llms.txt</a>
        </li>
        <li>
          <a href="/sitemap.xml">sitemap.xml</a>
        </li>
      </ul>
    </details>
  </section>
</PublicLayout>
