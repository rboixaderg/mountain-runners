---
import * as messages from "../paraglide/messages.js";
import PublicLayout from "../layouts/PublicLayout.astro";

const locale = "ca";
const canonical = new URL("/404.html", Astro.site).toString();
---

<PublicLayout
  canonical={canonical}
  description={messages.not_found_description({}, { locale })}
  locale={locale}
  noindex={true}
  title={`${messages.not_found_title({}, { locale })} | ${messages.site_title()}`}
>
  <section
    class="page-frame max-w-reading py-[clamp(var(--space-12),10vw,7rem)]"
  >
    <p class="font-display tracking-display m-0 text-lg uppercase">404</p>
    <h1
      class="font-display text-display-home leading-display tracking-headline my-3 mb-6 max-w-[15ch] uppercase"
    >
      {messages.not_found_title({}, { locale })}
    </h1>
    <p class="text-[clamp(1.1rem,2vw,1.3rem)]">
      {messages.not_found_description({}, { locale })}
    </p>
    <a class="mt-6 inline-block font-bold" href="/ca/"
      >{messages.back_to_home({}, { locale })}</a
    >
    <p class="tracking-label mt-10 mb-2 text-xs font-bold uppercase">
      {messages.not_found_agent_resources({}, { locale })}
    </p>
    <ul class="m-0 list-none space-y-1 p-0 text-[0.95rem]">
      <li><a href="/llms.txt">llms.txt</a></li>
      <li><a href="/sitemap.xml">sitemap.xml</a></li>
    </ul>
  </section>
</PublicLayout>
