---
import { locales } from "../../../i18n.config.mjs";
import * as messages from "../../paraglide/messages.js";
import { assertIsLocale } from "../../paraglide/runtime.js";
import homepageImageAvif from "../../assets/home/homepage-hero.avif";
import homepageImageJpeg from "../../assets/home/homepage-hero.jpeg";
import homepageImageSmallAvif from "../../assets/home/homepage-hero-mobile.avif";
import HomepageEventCard from "../../components/events/HomepageEventCard.astro";
import PageHero from "../../components/PageHero.astro";
import PageHeroMedia from "../../components/PageHeroMedia.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import {
  getHomepageEvents,
  getMadridDate,
  getNextEdition,
} from "../../lib/content/events";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import { getOrderedSchoolVariants } from "../../lib/content/schools";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { PublishedVariant } from "../../lib/content/publication";
import { getPublicationCatalog } from "../../lib/content/repository";
import {
  getDomainPath,
  getFixedPagePath,
  getVariantPath,
} from "../../lib/content/routes";
import { getSiteJsonLd } from "../../lib/content/seo";
import { externalActionIds } from "../../lib/content/models";
import {
  getFederationLink,
  getMemberSignupLink,
} from "../../lib/presentation/status";
import { externalLinkAttributes } from "../../lib/presentation/urls";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../../lib/analytics/catalog";
import "../../styles/homepage.css";

const locale = assertIsLocale(Astro.currentLocale);
const canonicalUrl = new URL(`/${locale}/`, Astro.site);
const catalog = await getPublicationCatalog();
const today = process.env.BUILD_TODAY ?? getMadridDate(new Date());
const eventVariants = catalog.variants.filter(
  (variant): variant is Extract<PublishedVariant, { kind: "event" }> =>
    variant.kind === "event" && variant.locale === locale,
);
const schoolVariants = catalog.variants.filter(
  (variant): variant is Extract<PublishedVariant, { kind: "school" }> =>
    variant.kind === "school" && variant.locale === locale,
);
const events = getHomepageEvents(
  eventVariants.map((variant) => variant.entry),
  today,
).map((event) => {
  const variant = eventVariants.find(
    (candidate) => candidate.entry.id === event.id,
  );
  if (variant === undefined) {
    throw new Error(`Missing published variant for homepage event ${event.id}`);
  }
  return {
    edition: getNextEdition(event, today),
    event,
    href: getVariantPath(variant),
  };
});
const schools = getOrderedSchoolVariants(schoolVariants);
const schoolCards = await Promise.all(
  schools.map(async (variant) => {
    const resource = variant.entry.coverCard ?? variant.entry.cover.resource;
    return {
      variant,
      coverHref: getResourceHref(resource),
      coverSize:
        resource.kind === "local"
          ? await getLocalImageSize(resource.path)
          : undefined,
    };
  }),
);
const siteUrl = new URL("/", Astro.site);
const siteEntity = catalog.entities.get("mountain-runners");
const siteLogoUrl =
  siteEntity === undefined
    ? undefined
    : new URL(getResourceHref(siteEntity.logo.resource), siteUrl).toString();
const socialProfileUrls = (siteEntity?.links ?? [])
  .filter((link) => link.kind === "instagram" || link.kind === "strava")
  .map((link) => link.url);
const structuredData = getSiteJsonLd({
  logoUrl: siteLogoUrl,
  name: siteEntity?.name[locale],
  sameAs: socialProfileUrls,
  siteUrl,
});
const eventsPath = getDomainPath("event", locale);
const membersPath = getFixedPagePath("members", locale);
const memberSignupLink = getMemberSignupLink(
  catalog.externalActions.get(externalActionIds.memberSignup),
  locale,
  membersPath,
);
const federationLink = getFederationLink(
  catalog.externalActions.get(externalActionIds.federation),
  locale,
  membersPath,
);
const schoolsPath = getDomainPath("school", locale);
const homepageSchoolsAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsAreas.homepage,
  target: "schools",
});
const homepageMembersAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsAreas.homepage,
  target: "members",
});
const homepageEventsAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsAreas.homepage,
  target: "events",
});
const homepageSignupAttributes = analyticsActionAttributes({
  action: analyticsActions.memberSignup,
  area: analyticsAreas.homepage,
  target: "signup",
});
const homepageFederationAttributes = analyticsActionAttributes({
  action: analyticsActions.federationSignup,
  area: analyticsAreas.homepage,
  target: "federation",
});

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
---

<PublicLayout
  canonical={canonicalUrl.toString()}
  description={messages.homepage_page_description({}, { locale })}
  locale={locale}
  localizedAlternatives={locales.map((alternativeLocale) => ({
    locale: assertIsLocale(alternativeLocale),
    href: new URL(`/${alternativeLocale}/`, Astro.site).toString(),
  }))}
  socialImage={{
    alt: messages.homepage_hero_image_alt({}, { locale }),
    url: new URL(homepageImageJpeg.src, Astro.site).toString(),
  }}
  structuredData={structuredData}
  title={messages.homepage_hero_title({}, { locale })}
>
  <PageHero
    className="homepage-hero max-md:min-h-0 max-md:pt-11 max-md:pb-16"
    contentClassName="homepage-hero__grid grid items-center md:grid-cols-12"
  >
    <PageHeroMedia
      slot="media"
      fetchpriority="high"
      image={homepageImageSmallAvif}
      imageClassName="homepage-hero__mountain absolute"
      imageLarge={homepageImageAvif}
      loading="eager"
    />
    <div
      class="homepage-hero__intro relative z-[2] grid max-w-[42rem] gap-6 md:col-span-9"
    >
      <h1
        class="font-display m-0 max-w-[14ch] text-[clamp(2.6rem,7vw,5.25rem)] leading-[0.92] font-bold tracking-[-0.03em] uppercase max-md:text-[clamp(2.4rem,12vw,3.25rem)]"
      >
        <span class="homepage-hero__title-club"
          >{messages.homepage_hero_title_club({}, { locale })}</span
        >{" "}<span class="homepage-hero__title-region block"
          >{messages.homepage_hero_title_region({}, { locale })}</span
        >
      </h1>
      <div
        class="homepage-hero__copy max-w-[30rem] text-[clamp(1.05rem,1.8vw,1.3rem)] leading-normal font-medium max-md:max-w-none max-md:text-base"
        set:html={renderRestrictedMarkdown(
          messages.homepage_hero_description({}, { locale }),
        )}
      />
      <div
        class="homepage-hero__actions mt-4 flex flex-wrap items-center gap-x-4 gap-y-3"
      >
        <a
          class="homepage-join-cta border-ink font-display text-ink hover:bg-ink inline-flex min-h-11 items-center gap-3 border-2 bg-white px-6 py-[0.85rem] text-[0.8rem] leading-[1.2] font-bold tracking-[0.12em] uppercase no-underline hover:border-white hover:text-white"
          href={memberSignupLink.href}
          {...memberSignupLink.isExternal ? externalLinkAttributes : {}}
          {...homepageSignupAttributes}
        >
          {messages.cta_join_members({}, { locale })}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          class="homepage-hero__cta border-paper font-display text-paper hover:border-paper hover:bg-paper hover:text-ink inline-flex min-h-11 -rotate-1 items-center gap-3 border-2 bg-transparent px-6 py-[0.85rem] text-[0.8rem] leading-[1.2] font-bold tracking-[0.12em] uppercase no-underline"
          href={schoolsPath}
          {...homepageSchoolsAttributes}
        >
          {messages.homepage_schools_title({}, { locale })}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          class="homepage-hero__cta border-paper font-display text-paper hover:border-paper hover:bg-paper hover:text-ink inline-flex min-h-11 -rotate-1 items-center gap-3 border-2 bg-transparent px-6 py-[0.85rem] text-[0.8rem] leading-[1.2] font-bold tracking-[0.12em] uppercase no-underline"
          href={federationLink.href}
          {...federationLink.isExternal ? externalLinkAttributes : {}}
          {...homepageFederationAttributes}
        >
          {messages.homepage_federation_cta({}, { locale })}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </PageHero>

  <section
    class="homepage-school-section bg-ink text-paper relative overflow-hidden py-[clamp(4rem,8vw,6rem)]"
  >
    <div
      class="page-frame homepage-school-section__inner grid justify-items-center gap-[clamp(2.5rem,5vw,3.5rem)]"
    >
      <div
        class="homepage-school-section__heading grid max-w-[40rem] gap-4 text-center"
      >
        <h2
          class="font-display m-0 text-[clamp(2.25rem,5.5vw,3.75rem)] font-bold tracking-[-0.02em] uppercase"
        >
          {messages.homepage_schools_title({}, { locale })}
        </h2>
        <div
          class="text-[clamp(1.05rem,2vw,1.25rem)] leading-normal text-white/78"
          set:html={renderRestrictedMarkdown(
            messages.homepage_schools_description({}, { locale }),
          )}
        />
      </div>
      <ul
        class="homepage-school-list m-0 grid w-full list-none grid-cols-1 gap-4 p-0 md:grid-cols-3"
      >
        {
          schoolCards.map(({ variant, coverHref, coverSize }) => (
            <li class="bg-paper text-ink max-md:max-w-[28rem]">
              <a
                class="homepage-school-list__link grid h-full grid-rows-[auto_auto_1fr_auto] gap-3 p-4 text-inherit no-underline"
                href={getVariantPath(variant)}
                {...analyticsActionAttributes({
                  action: analyticsActions.navigate,
                  area: analyticsAreas.homepage,
                  target: variant.entry.id,
                })}
              >
                <img
                  class="homepage-school-list__mark bg-stone aspect-[4/3] w-full object-cover contrast-105 grayscale"
                  src={coverHref}
                  width={coverSize?.width}
                  height={coverSize?.height}
                  loading="lazy"
                  alt=""
                />
                <strong class="font-display text-[1.4rem] leading-[1.1] uppercase">
                  {variant.entry.name[locale]}
                </strong>
                <span class="homepage-school-list__summary text-muted text-[0.9rem] leading-[1.55]">
                  {variant.entry.summary[locale]}
                </span>
                <span class="homepage-school-list__action font-display text-red mt-4 self-end text-xs leading-normal font-bold tracking-[0.12em] uppercase underline decoration-[0.1rem] underline-offset-[0.3rem]">
                  {messages.homepage_school_action({}, { locale })}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="homepage-members-banner py-[clamp(3rem,6vw,4.5rem)]">
    <div class="page-frame">
      <div
        class="homepage-members-banner__inner bg-red text-paper p-[clamp(2.25rem,5vw,4rem)]"
      >
        <div
          class="homepage-members-banner__copy grid max-w-[40rem] justify-items-start gap-4"
        >
          <h2
            class="font-display m-0 text-[clamp(2.25rem,5vw,3.5rem)] leading-[0.95] font-normal tracking-[-0.02em] uppercase"
          >
            {messages.homepage_members_title({}, { locale })}
          </h2>
          <div
            class="text-[clamp(1.05rem,2vw,1.25rem)] leading-normal"
            set:html={renderRestrictedMarkdown(
              messages.homepage_members_description({}, { locale }),
            )}
          />
          <a
            class="homepage-members-banner__action border-ink font-display text-ink hover:bg-ink mt-2 inline-flex min-h-11 items-center gap-3 border-2 bg-white px-6 py-[0.85rem] text-[0.8rem] leading-[1.2] font-bold tracking-[0.12em] uppercase no-underline hover:border-white hover:text-white"
            href={membersPath}
            {...homepageMembersAttributes}
          >
            {messages.homepage_members_action({}, { locale })}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    class="page-frame homepage-section py-[clamp(3.5rem,7vw,5.5rem)]"
    aria-labelledby="events-title"
  >
    <div
      class="homepage-section__header mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3"
    >
      <h2
        id="events-title"
        class="font-display m-0 text-[clamp(2.25rem,5.5vw,3.75rem)] font-bold tracking-[-0.02em] uppercase"
      >
        {messages.homepage_events_title({}, { locale })}
      </h2>
      <a
        class="font-display text-red hover:text-ink text-[0.8rem] font-bold tracking-[0.12em] uppercase underline decoration-[0.1rem] underline-offset-[0.3rem]"
        href={eventsPath}
        {...homepageEventsAttributes}
      >
        {messages.homepage_events_view_all({}, { locale })}
      </a>
    </div>
    <div class="homepage-events border-line grid border-t">
      {
        events.map(({ edition, event, href }, index) => (
          <HomepageEventCard
            analyticsArea={analyticsAreas.homepage}
            edition={edition}
            event={event}
            featured={index === 0}
            href={href}
            locale={locale}
            today={today}
          />
        ))
      }
    </div>
  </section>
</PublicLayout>

<style>
  .homepage-hero__copy :global(:first-child),
  .homepage-school-section__heading > div :global(:first-child),
  .homepage-members-banner__copy > div :global(:first-child) {
    margin-top: 0;
  }

  .homepage-members-banner__copy > div :global(ul) {
    margin: 1rem 0 0;
    padding-left: 1.25rem;
  }

  .homepage-members-banner__copy > div :global(li + li) {
    margin-top: 0.5rem;
  }

  .homepage-hero__copy :global(:last-child),
  .homepage-school-section__heading > div :global(:last-child),
  .homepage-members-banner__copy > div :global(:last-child),
  .homepage-event__description :global(:last-child) {
    margin-bottom: 0;
  }

  .homepage-event__description :global(:first-child) {
    margin-top: 0;
  }
</style>
