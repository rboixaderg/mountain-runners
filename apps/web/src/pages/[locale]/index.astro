---
import { locales } from "../../../i18n.config.mjs";
import * as messages from "../../paraglide/messages.js";
import { assertIsLocale } from "../../paraglide/runtime.js";
import logo from "../../assets/logo_mountain_runners.png";
import homepageImage from "../../assets/members/socis-portada.jpg";
import homepageImageSmall from "../../assets/members/socis-portada-hero.jpg";
import HomepageEventCard from "../../components/events/HomepageEventCard.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getHomepageEvents, getMadridDate } from "../../lib/content/events";
import { getOrderedSchoolVariants } from "../../lib/content/schools";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { PublishedVariant } from "../../lib/content/publication";
import { getPublicationCatalog } from "../../lib/content/repository";
import { getDomainPath, getFixedPagePath } from "../../lib/content/routes";
import { getSiteJsonLd } from "../../lib/content/seo";

const locale = assertIsLocale(Astro.currentLocale);
const canonicalUrl = new URL(`/${locale}/`, Astro.site);
const catalog = await getPublicationCatalog();
const today = process.env.BUILD_TODAY ?? getMadridDate(new Date());
const eventVariants = catalog.variants.filter(
  (variant): variant is Extract<PublishedVariant, { kind: "event" }> =>
    variant.kind === "event" && variant.locale === locale,
);
const schoolVariants = catalog.variants.filter(
  (variant): variant is Extract<PublishedVariant, { kind: "school" }> =>
    variant.kind === "school" && variant.locale === locale,
);
const events = getHomepageEvents(
  eventVariants.map((variant) => variant.entry),
  today,
);
const schools = getOrderedSchoolVariants(schoolVariants).map(
  (variant) => variant.entry,
);
const siteUrl = new URL("/", Astro.site);
const siteEntity = catalog.entities.get("mountain-runners");
const structuredData = getSiteJsonLd({
  name: siteEntity?.name[locale],
  siteUrl,
});

export function getStaticPaths() {
  return locales
    .filter((locale) => locale === "ca")
    .map((locale) => ({ params: { locale } }));
}
---

<PublicLayout
  canonical={canonicalUrl.toString()}
  description={messages.homepage_hero_description({}, { locale })}
  locale={locale}
  structuredData={structuredData}
  title={messages.homepage_hero_title({}, { locale })}
>
  <section class="homepage-hero">
    <picture>
      <source media="(min-width: 48rem)" srcset={homepageImage.src} />
      <img
        class="homepage-hero__mountain"
        src={homepageImageSmall.src}
        width={homepageImageSmall.width}
        height={homepageImageSmall.height}
        loading="eager"
        fetchpriority="high"
        alt=""
      />
    </picture>
    <div class="page-frame homepage-hero__grid">
      <div class="homepage-hero__intro">
        <p class="homepage-kicker">MRB</p>
        <h1>{messages.homepage_hero_title({}, { locale })}</h1>
        <div
          class="homepage-hero__copy"
          set:html={renderRestrictedMarkdown(
            messages.homepage_hero_description({}, { locale }),
          )}
        />
      </div>
      <img
        class="homepage-hero__logo"
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt={messages.homepage_hero_image_alt({}, { locale })}
      />
    </div>
  </section>

  <section class="page-frame homepage-section" aria-labelledby="events-title">
    <div class="homepage-section__heading">
      <p class="homepage-kicker">{messages.site_title({}, { locale })}</p>
      <h2 id="events-title">
        {messages.homepage_events_title({}, { locale })}
      </h2>
      <div
        set:html={renderRestrictedMarkdown(
          messages.homepage_events_description({}, { locale }),
        )}
      />
    </div>
    <div class="homepage-events">
      {
        events.map((event) => (
          <HomepageEventCard event={event} locale={locale} today={today} />
        ))
      }
    </div>
    <a class="homepage-link" href={getDomainPath("event", locale)}>
      {messages.navigation_events({}, { locale })}
    </a>
  </section>

  <section class="homepage-school-section">
    <div class="page-frame homepage-school-section__grid">
      <div class="homepage-section__heading">
        <p class="homepage-kicker">MRB</p>
        <h2>{messages.homepage_schools_title({}, { locale })}</h2>
        <div
          set:html={renderRestrictedMarkdown(
            messages.homepage_schools_description({}, { locale }),
          )}
        />
      </div>
      <ul class="homepage-school-list">
        {
          schools.map((school) => (
            <li>
              <img
                class="homepage-school-list__mark"
                src={logo.src}
                width={logo.width}
                height={logo.height}
                alt=""
              />
              <strong>{school.name[locale]}</strong>
              <span>{school.summary[locale]}</span>
            </li>
          ))
        }
      </ul>
      <a
        class="homepage-link homepage-school-section__link"
        href={getDomainPath("school", locale)}
      >
        {messages.navigation_schools({}, { locale })}
      </a>
    </div>
  </section>

  <section class="page-frame homepage-club-section">
    <div class="homepage-members-card">
      <p class="homepage-kicker">MRB</p>
      <h2>{messages.homepage_members_title({}, { locale })}</h2>
      <div
        set:html={renderRestrictedMarkdown(
          messages.homepage_members_description({}, { locale }),
        )}
      />
      <a class="homepage-link" href={getFixedPagePath("members", locale)}>
        {messages.navigation_members({}, { locale })}
      </a>
    </div>
    <div class="homepage-community-card">
      <p class="homepage-kicker">Berguedà</p>
      <h2>{messages.homepage_community_title({}, { locale })}</h2>
      <div
        set:html={renderRestrictedMarkdown(
          messages.homepage_community_description({}, { locale }),
        )}
      />
    </div>
  </section>
</PublicLayout>
