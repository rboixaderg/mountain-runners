---
import { locales } from "../../../i18n.config.mjs";
import * as messages from "../../paraglide/messages.js";
import { assertIsLocale } from "../../paraglide/runtime.js";
import homepageImage from "../../assets/home/homepage-hero.jpeg";
import homepageImageSmall from "../../assets/home/homepage-hero-mobile.jpeg";
import HomepageEventCard from "../../components/events/HomepageEventCard.astro";
import PageHero from "../../components/PageHero.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getHomepageEvents, getMadridDate } from "../../lib/content/events";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import { getOrderedSchoolVariants } from "../../lib/content/schools";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { PublishedVariant } from "../../lib/content/publication";
import { getPublicationCatalog } from "../../lib/content/repository";
import {
  getDomainPath,
  getFixedPagePath,
  getVariantPath,
} from "../../lib/content/routes";
import { getSiteJsonLd } from "../../lib/content/seo";
import "../../styles/homepage.css";

const locale = assertIsLocale(Astro.currentLocale);
const canonicalUrl = new URL(`/${locale}/`, Astro.site);
const catalog = await getPublicationCatalog();
const today = process.env.BUILD_TODAY ?? getMadridDate(new Date());
const eventVariants = catalog.variants.filter(
  (variant): variant is Extract<PublishedVariant, { kind: "event" }> =>
    variant.kind === "event" && variant.locale === locale,
);
const schoolVariants = catalog.variants.filter(
  (variant): variant is Extract<PublishedVariant, { kind: "school" }> =>
    variant.kind === "school" && variant.locale === locale,
);
const events = getHomepageEvents(
  eventVariants.map((variant) => variant.entry),
  today,
).map((event) => {
  const variant = eventVariants.find(
    (candidate) => candidate.entry.id === event.id,
  );
  if (variant === undefined) {
    throw new Error(`Missing published variant for homepage event ${event.id}`);
  }
  return { event, href: getVariantPath(variant) };
});
const schools = getOrderedSchoolVariants(schoolVariants);
const schoolCards = await Promise.all(
  schools.map(async (variant) => {
    const resource = variant.entry.cover.resource;
    return {
      variant,
      coverHref: getResourceHref(resource),
      coverSize:
        resource.kind === "local"
          ? await getLocalImageSize(resource.path)
          : undefined,
    };
  }),
);
const siteUrl = new URL("/", Astro.site);
const siteEntity = catalog.entities.get("mountain-runners");
const structuredData = getSiteJsonLd({
  name: siteEntity?.name[locale],
  siteUrl,
});
const eventsPath = getDomainPath("event", locale);
const membersPath = getFixedPagePath("members", locale);

export function getStaticPaths() {
  return locales
    .filter((locale) => locale === "ca")
    .map((locale) => ({ params: { locale } }));
}
---

<PublicLayout
  canonical={canonicalUrl.toString()}
  description={messages.homepage_hero_description({}, { locale })}
  locale={locale}
  structuredData={structuredData}
  title={messages.homepage_hero_title({}, { locale })}
>
  <PageHero
    className="homepage-hero"
    contentClassName="homepage-hero__grid grid items-center md:grid-cols-12"
  >
    <picture slot="media">
      <source media="(min-width: 48rem)" srcset={homepageImage.src} />
      <img
        class="homepage-hero__mountain"
        src={homepageImageSmall.src}
        width={homepageImageSmall.width}
        height={homepageImageSmall.height}
        loading="eager"
        fetchpriority="high"
        alt=""
      />
    </picture>
    <div
      class="homepage-hero__intro relative z-[2] grid max-w-[42rem] gap-6 md:col-span-9"
    >
      <h1
        class="font-display m-0 max-w-[14ch] text-[clamp(2.6rem,7vw,5.25rem)] leading-[0.92] font-bold tracking-[-0.03em] uppercase max-md:text-[clamp(2.4rem,12vw,3.25rem)]"
      >
        <span class="homepage-hero__title-club"
          >{messages.homepage_hero_title_club({}, { locale })}</span
        >{" "}<span class="homepage-hero__title-region"
          >{messages.homepage_hero_title_region({}, { locale })}</span
        >
      </h1>
      <div
        class="homepage-hero__copy max-w-[30rem] text-[clamp(1.05rem,1.8vw,1.3rem)] leading-normal font-medium max-md:max-w-none max-md:text-base"
        set:html={renderRestrictedMarkdown(
          messages.homepage_hero_description({}, { locale }),
        )}
      />
      <div
        class="homepage-hero__actions mt-4 flex flex-wrap items-center gap-x-4 gap-y-3"
      >
        <a
          class="homepage-hero__cta border-ink bg-paper font-display text-ink inline-flex min-h-11 items-center gap-3 border-2 px-6 py-[0.85rem] text-[0.8rem] leading-[1.2] font-bold tracking-[0.12em] uppercase no-underline"
          href={eventsPath}
        >
          {messages.homepage_hero_cta({}, { locale })}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </PageHero>

  <section
    class="page-frame homepage-section py-[clamp(3.5rem,7vw,5.5rem)]"
    aria-labelledby="events-title"
  >
    <div
      class="homepage-section__header mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3"
    >
      <h2
        id="events-title"
        class="font-display m-0 text-[clamp(2.25rem,5.5vw,3.75rem)] font-bold tracking-[-0.02em] uppercase"
      >
        {messages.homepage_events_title({}, { locale })}
      </h2>
      <a
        class="homepage-section__view-all font-display text-red text-[0.8rem] font-bold tracking-[0.12em] uppercase underline decoration-[0.1rem] underline-offset-[0.3rem]"
        href={eventsPath}
      >
        {messages.homepage_events_view_all({}, { locale })}
      </a>
    </div>
    <div class="homepage-events border-line grid border-t">
      {
        events.map(({ event, href }, index) => (
          <HomepageEventCard
            event={event}
            featured={index === 0}
            href={href}
            locale={locale}
            today={today}
          />
        ))
      }
    </div>
  </section>

  <section
    class="homepage-school-section bg-ink text-paper relative overflow-hidden py-[clamp(4rem,8vw,6rem)]"
  >
    <div
      class="page-frame homepage-school-section__inner grid justify-items-center gap-[clamp(2.5rem,5vw,3.5rem)]"
    >
      <div
        class="homepage-school-section__heading grid max-w-[40rem] gap-4 text-center"
      >
        <h2
          class="font-display m-0 text-[clamp(2.25rem,5.5vw,3.75rem)] font-bold tracking-[-0.02em] uppercase"
        >
          {messages.homepage_schools_title({}, { locale })}
        </h2>
        <div
          class="text-[clamp(1.05rem,2vw,1.25rem)] leading-normal text-white/78"
          set:html={renderRestrictedMarkdown(
            messages.homepage_schools_description({}, { locale }),
          )}
        />
      </div>
      <ul
        class="homepage-school-list m-0 grid w-full list-none grid-cols-1 gap-4 p-0 md:grid-cols-3"
      >
        {
          schoolCards.map(({ variant, coverHref, coverSize }) => (
            <li class="bg-paper text-ink max-md:max-w-[28rem]">
              <a
                class="homepage-school-list__link grid h-full grid-rows-[auto_auto_1fr_auto] gap-3 p-4 text-inherit no-underline"
                href={getVariantPath(variant)}
              >
                <img
                  class="homepage-school-list__mark bg-stone aspect-[4/3] w-full object-cover contrast-105 grayscale"
                  src={coverHref}
                  width={coverSize?.width}
                  height={coverSize?.height}
                  loading="lazy"
                  alt=""
                />
                <strong class="font-display text-[1.4rem] leading-[1.1] uppercase">
                  {variant.entry.name[locale]}
                </strong>
                <span class="homepage-school-list__summary text-muted text-[0.9rem] leading-[1.55]">
                  {variant.entry.summary[locale]}
                </span>
                <span class="homepage-school-list__action font-display text-red mt-4 self-end text-xs font-bold tracking-[0.12em] uppercase underline decoration-[0.1rem] underline-offset-[0.3rem]">
                  {messages.homepage_school_action({}, { locale })}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="homepage-members-banner py-[clamp(3rem,6vw,4.5rem)]">
    <div class="page-frame">
      <div
        class="homepage-members-banner__inner bg-red text-paper p-[clamp(2.25rem,5vw,4rem)]"
      >
        <div
          class="homepage-members-banner__copy grid max-w-[40rem] justify-items-start gap-4"
        >
          <h2
            class="font-display m-0 text-[clamp(2.25rem,5vw,3.5rem)] leading-[0.95] font-bold tracking-[-0.02em] uppercase"
          >
            {messages.homepage_members_title({}, { locale })}
          </h2>
          <div
            class="text-[clamp(1.05rem,2vw,1.25rem)] leading-normal"
            set:html={renderRestrictedMarkdown(
              messages.homepage_members_description({}, { locale }),
            )}
          />
          <a
            class="homepage-members-banner__cta border-ink font-display text-ink mt-2 inline-flex min-h-11 items-center gap-3 border-2 bg-white px-6 py-[0.85rem] text-[0.8rem] leading-[1.2] font-bold tracking-[0.12em] uppercase no-underline"
            href={membersPath}
          >
            {messages.cta_join_members({}, { locale })}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .homepage-hero__copy :global(:first-child),
  .homepage-school-section__heading > div :global(:first-child),
  .homepage-members-banner__copy > div :global(:first-child) {
    margin-top: 0;
  }

  .homepage-hero__copy :global(:last-child),
  .homepage-school-section__heading > div :global(:last-child),
  .homepage-members-banner__copy > div :global(:last-child),
  .homepage-event__description :global(:last-child) {
    margin-bottom: 0;
  }

  .homepage-event__description :global(:first-child) {
    margin-top: 0;
  }
</style>
