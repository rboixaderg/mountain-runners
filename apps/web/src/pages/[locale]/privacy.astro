---
import * as messages from "../../paraglide/messages.js";
import { assertIsLocale } from "../../paraglide/runtime.js";
import LegalPrivacyDetail from "../../components/legal/LegalPrivacyDetail.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getPublicationCatalog } from "../../lib/content/repository";
import {
  getFixedPagePath,
  getLocalizedFixedPageAlternatives,
} from "../../lib/content/routes";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }];
}

const locale = assertIsLocale(Astro.currentLocale);
const catalog = await getPublicationCatalog();
const canonical = new URL(
  getFixedPagePath("legal-privacy", locale),
  Astro.site,
).toString();
---

<PublicLayout
  canonical={canonical}
  description={messages.legal_privacy_description({}, { locale })}
  locale={locale}
  localizedAlternatives={getLocalizedFixedPageAlternatives(
    "legal-privacy",
    Astro.site!,
  )}
  title={`${messages.legal_privacy_title({}, { locale })} | ${messages.site_title({}, { locale })}`}
>
  <LegalPrivacyDetail catalog={catalog} locale={locale} />
</PublicLayout>
