---
import { locales } from "../../../i18n.config.mjs";
import MembersDetail from "../../components/members/MembersDetail.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getPublicationCatalog } from "../../lib/content/repository";
import {
  getFixedPagePath,
  getLocalizedFixedPageAlternatives,
} from "../../lib/content/routes";
import * as messages from "../../paraglide/messages.js";
import { assertIsLocale } from "../../paraglide/runtime.js";

export function getStaticPaths() {
  return locales
    .filter((locale) => locale === "ca")
    .map((locale) => ({ params: { locale } }));
}

const locale = assertIsLocale(Astro.currentLocale);
const catalog = await getPublicationCatalog();
const canonical = new URL(
  getFixedPagePath("members", locale),
  Astro.site,
).toString();
---

<PublicLayout
  canonical={canonical}
  description={messages.members_page_description({}, { locale })}
  locale={locale}
  localizedAlternatives={getLocalizedFixedPageAlternatives(
    "members",
    Astro.site!,
  )}
  title={`${messages.navigation_members({}, { locale })} | ${messages.site_title({}, { locale })}`}
>
  <MembersDetail catalog={catalog} locale={locale} />
</PublicLayout>
