---
import { locales } from "../../../i18n.config.mjs";
import * as messages from "../../paraglide/messages.js";
import { assertIsLocale } from "../../paraglide/runtime.js";
import AboutDetail from "../../components/about/AboutDetail.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getPublicationCatalog } from "../../lib/content/repository";
import {
  getFixedPagePath,
  getLocalizedFixedPageAlternatives,
} from "../../lib/content/routes";

export function getStaticPaths() {
  return locales
    .filter((locale) => locale === "ca")
    .map((locale) => ({ params: { locale } }));
}

const locale = assertIsLocale(Astro.currentLocale);
const catalog = await getPublicationCatalog();
const canonical = new URL(
  getFixedPagePath("about", locale),
  Astro.site,
).toString();
---

<PublicLayout
  canonical={canonical}
  description={messages.about_page_description({}, { locale })}
  locale={locale}
  localizedAlternatives={getLocalizedFixedPageAlternatives(
    "about",
    Astro.site!,
  )}
  title={`${messages.navigation_about({}, { locale })} | ${messages.site_title({}, { locale })}`}
>
  <AboutDetail catalog={catalog} locale={locale} />
</PublicLayout>
