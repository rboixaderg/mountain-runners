---
import * as messages from "../../../paraglide/messages.js";
import EventDetail from "../../../components/events/EventDetail.astro";
import SchoolDetail from "../../../components/schools/SchoolDetail.astro";
import PublicLayout from "../../../layouts/PublicLayout.astro";
import {
  getMadridDate,
  getMostRelevantEdition,
} from "../../../lib/content/events";
import type { Locale } from "../../../lib/content/primitives";
import type { PublishedVariant } from "../../../lib/content/publication";
import { getPublicationCatalog } from "../../../lib/content/repository";
import {
  getCanonicalUrl,
  getLocalizedAlternatives,
  getPublicDetailVariants,
  getRouteDomain,
} from "../../../lib/content/routes";
import { getEventJsonLd } from "../../../lib/content/seo";

export async function getStaticPaths() {
  const catalog = await getPublicationCatalog();
  const site = new URL(import.meta.env.SITE);
  return getPublicDetailVariants(catalog).map((variant) => ({
    params: {
      locale: variant.locale,
      domain: getRouteDomain(variant.kind, variant.locale),
      slug: variant.slug,
    },
    props: {
      variant,
      localizedAlternatives: getLocalizedAlternatives(catalog, variant, site),
    },
  }));
}

const { variant, localizedAlternatives } = Astro.props as {
  variant: PublishedVariant;
  localizedAlternatives: { locale: Locale; href: string }[];
};
const { locale } = variant;
const catalog = await getPublicationCatalog();
const today = process.env.BUILD_TODAY ?? getMadridDate(new Date());
const event =
  variant.kind === "event"
    ? (variant as Extract<PublishedVariant, { kind: "event" }>).entry
    : null;
const featuredEdition = event
  ? getMostRelevantEdition(event, today)
  : undefined;
const canonicalUrl = new URL(getCanonicalUrl(variant, Astro.site!));
const structuredData =
  event !== null && featuredEdition !== undefined
    ? [
        getEventJsonLd({
          event,
          edition: featuredEdition,
          canonicalUrl,
          locale,
          today,
        }),
      ].filter((data) => data !== undefined)
    : [];
---

<PublicLayout
  localizedAlternatives={localizedAlternatives}
  canonical={canonicalUrl.toString()}
  description={variant.kind === "event"
    ? variant.entry.description[locale]!
    : variant.entry.summary[locale]!}
  locale={locale}
  structuredData={structuredData}
  title={`${variant.kind === "event" ? variant.entry.title[locale] : variant.entry.name[locale]} | ${messages.site_title({}, { locale })}`}
>
  {
    variant.kind === "event" ? (
      <EventDetail
        catalog={catalog}
        locale={locale}
        today={today}
        variant={variant}
      />
    ) : (
      <SchoolDetail locale={locale} variant={variant} />
    )
  }
</PublicLayout>
