---
import * as messages from "../../../paraglide/messages.js";
import { assertIsLocale } from "../../../paraglide/runtime.js";
import EventMonthlyCalendar from "../../../components/events/EventMonthlyCalendar.astro";
import EventsHubActiveCard from "../../../components/events/EventsHubActiveCard.astro";
import EventsHubHistoryTable from "../../../components/events/EventsHubHistoryTable.astro";
import HomepageEventCard from "../../../components/events/HomepageEventCard.astro";
import SchoolHub from "../../../components/schools/SchoolHub.astro";
import PublicLayout from "../../../layouts/PublicLayout.astro";
import hubHeroImage from "../../../assets/events/events-hub-hero.webp";
import hubHeroImageSmall from "../../../assets/events/events-hub-hero-mobile.webp";
import schoolsHubHero from "../../../assets/schools/schools-hub-hero.jpg";
import PageIntro from "../../../components/PageIntro.astro";
import {
  getEventHubGroups,
  getMadridDate,
  getNextEdition,
  type EventHubGroup,
} from "../../../lib/content/events";
import { getOrderedSchoolVariants } from "../../../lib/content/schools";
import type { PublishedVariant } from "../../../lib/content/publication";
import { getPublicationCatalog } from "../../../lib/content/repository";
import {
  getDomainPath,
  getRouteDomain,
  getVariantPath,
} from "../../../lib/content/routes";
import { getEventHistoryRows } from "../../../lib/presentation/events";
import "../../../styles/events-hub.css";
import "../../../styles/homepage.css";

export async function getStaticPaths() {
  const catalog = await getPublicationCatalog();
  const eventLocales = new Set(
    catalog.variants
      .filter(
        (variant): variant is Extract<PublishedVariant, { kind: "event" }> =>
          variant.kind === "event",
      )
      .map(({ locale }) => locale),
  );
  const schoolLocales = new Set(
    catalog.variants
      .filter(
        (variant): variant is Extract<PublishedVariant, { kind: "school" }> =>
          variant.kind === "school",
      )
      .map(({ locale }) => locale),
  );
  return [
    ...[...eventLocales].map((locale) => ({
      params: { locale, domain: getRouteDomain("event", locale) },
      props: { kind: "event" as const },
    })),
    ...[...schoolLocales].map((locale) => ({
      params: { locale, domain: getRouteDomain("school", locale) },
      props: { kind: "school" as const },
    })),
  ];
}

const { kind } = Astro.props;
const locale = assertIsLocale(Astro.currentLocale);
const canonical = new URL(getDomainPath(kind, locale), Astro.site).toString();
const catalog = await getPublicationCatalog();
const today = process.env.BUILD_TODAY ?? getMadridDate(new Date());
// The hub publishes one route per locale that has variants of this domain;
// the hreflang alternatives mirror exactly those published hubs.
const hubLocales = new Set(
  catalog.variants
    .filter((variant) => variant.kind === kind)
    .map(({ locale: variantLocale }) => variantLocale),
);
const localizedAlternatives = [...hubLocales].map((alternativeLocale) => ({
  locale: alternativeLocale,
  href: new URL(getDomainPath(kind, alternativeLocale), Astro.site).toString(),
}));
const eventVariants = catalog.variants.filter(
  (variant): variant is Extract<PublishedVariant, { kind: "event" }> =>
    variant.kind === "event" && variant.locale === locale,
);
const schoolVariants = getOrderedSchoolVariants(
  catalog.variants.filter(
    (variant): variant is Extract<PublishedVariant, { kind: "school" }> =>
      variant.kind === "school" && variant.locale === locale,
  ),
);
const publishedEvents = eventVariants.map(({ entry }) => entry);
const groups = getEventHubGroups(publishedEvents, today);
const getVariantFor = (id: string) =>
  eventVariants.find(({ entry }) => entry.id === id)!;
const historyRows = getEventHistoryRows(groups.past, locale, (event) =>
  getVariantPath(getVariantFor(event.id)),
);
const hubSections: {
  group: EventHubGroup;
  title: string;
  id: string;
}[] = [
  {
    group: "upcoming",
    title: messages.events_upcoming_title({}, { locale }),
    id: "upcoming",
  },
  {
    group: "active-without-date",
    title: messages.events_active_without_date_title({}, { locale }),
    id: "active-without-date",
  },
  {
    group: "past",
    title: messages.events_past_title({}, { locale }),
    id: "past",
  },
];
const hubTitle =
  kind === "school"
    ? messages.navigation_schools({}, { locale })
    : messages.navigation_events({}, { locale });
const hubDescription =
  kind === "school"
    ? messages.schools_page_description({}, { locale })
    : messages.events_page_description({}, { locale });
const socialImage =
  kind === "school"
    ? {
        alt: hubTitle,
        url: new URL(schoolsHubHero.src, Astro.site).toString(),
      }
    : {
        alt: hubTitle,
        url: new URL(hubHeroImage.src, Astro.site).toString(),
      };
---

<PublicLayout
  canonical={canonical}
  description={hubDescription}
  locale={locale}
  localizedAlternatives={localizedAlternatives}
  socialImage={socialImage}
  title={`${hubTitle} | ${messages.site_title({}, { locale })}`}
>
  {
    kind === "school" ? (
      <SchoolHub locale={locale} variants={schoolVariants} />
    ) : (
      <>
        <PageIntro
          description={messages.events_intro({}, { locale })}
          heroAttribution={messages.events_hero_attribution({}, { locale })}
          heroImage={hubHeroImageSmall}
          heroImageLarge={hubHeroImage}
          kicker={messages.site_title({}, { locale })}
          title={messages.navigation_events({}, { locale })}
        />

        <EventMonthlyCalendar
          events={publishedEvents}
          locale={locale}
          resolveEventHref={(event) => getVariantPath(getVariantFor(event.id))}
          today={today}
        />

        {hubSections.map((section) => {
          const events = groups[section.group];
          if (section.group === "past") {
            if (historyRows.length === 0) return null;
            return (
              <section
                class:list={[
                  "page-frame",
                  "events-hub-section",
                  "events-hub-section--past",
                ]}
                aria-labelledby={section.id}
              >
                <div class="events-hub-section__heading">
                  <span class="events-hub-section__marker" aria-hidden="true" />
                  <h2 id={section.id} class="events-hub-section__title">
                    {section.title}
                  </h2>
                </div>
                <EventsHubHistoryTable locale={locale} rows={historyRows} />
              </section>
            );
          }

          if (events.length === 0) return null;

          return (
            <section
              class:list={[
                "page-frame",
                "events-hub-section",
                `events-hub-section--${section.group}`,
              ]}
              aria-labelledby={section.id}
            >
              <div class="events-hub-section__heading">
                <span class="events-hub-section__marker" aria-hidden="true" />
                <h2 id={section.id} class="events-hub-section__title">
                  {section.title}
                </h2>
              </div>

              {section.group === "upcoming" ? (
                <div class="homepage-events border-line grid border-t">
                  {events.map((event, index) => (
                    <HomepageEventCard
                      edition={getNextEdition(event, today)}
                      event={event}
                      featured={index === 0}
                      href={getVariantPath(getVariantFor(event.id))}
                      locale={locale}
                      today={today}
                    />
                  ))}
                </div>
              ) : (
                <ul class="events-hub-active-list">
                  {events.map((event) => (
                    <EventsHubActiveCard
                      event={event}
                      locale={locale}
                      today={today}
                      variant={getVariantFor(event.id)}
                    />
                  ))}
                </ul>
              )}
            </section>
          );
        })}
      </>
    )
  }
</PublicLayout>
