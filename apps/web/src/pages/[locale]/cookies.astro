---
import { locales } from "../../../i18n.config.mjs";
import LegalCookiesDetail from "../../components/legal/LegalCookiesDetail.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import {
  getFixedPagePath,
  getLocalizedFixedPageAlternatives,
} from "../../lib/content/routes";
import * as messages from "../../paraglide/messages.js";
import { assertIsLocale } from "../../paraglide/runtime.js";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = assertIsLocale(Astro.currentLocale);
const canonical = new URL(
  getFixedPagePath("legal-cookies", locale),
  Astro.site,
).toString();
---

<PublicLayout
  canonical={canonical}
  description={messages.legal_cookies_description({}, { locale })}
  locale={locale}
  localizedAlternatives={getLocalizedFixedPageAlternatives(
    "legal-cookies",
    Astro.site!,
  )}
  title={`${messages.legal_cookies_title({}, { locale })} | ${messages.site_title({}, { locale })}`}
>
  <LegalCookiesDetail locale={locale} />
</PublicLayout>
