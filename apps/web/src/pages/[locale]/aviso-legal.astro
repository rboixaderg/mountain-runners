---
import LegalNoticeDetail from "../../components/legal/LegalNoticeDetail.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getPublicationCatalog } from "../../lib/content/repository";
import {
  getFixedPagePath,
  getLocalizedFixedPageAlternatives,
} from "../../lib/content/routes";
import * as messages from "../../paraglide/messages.js";
import { assertIsLocale } from "../../paraglide/runtime.js";

export function getStaticPaths() {
  return [{ params: { locale: "es" } }];
}

const locale = assertIsLocale(Astro.currentLocale);
const catalog = await getPublicationCatalog();
const canonical = new URL(
  getFixedPagePath("legal-notice", locale),
  Astro.site,
).toString();
---

<PublicLayout
  canonical={canonical}
  description={messages.legal_notice_description({}, { locale })}
  locale={locale}
  localizedAlternatives={getLocalizedFixedPageAlternatives(
    "legal-notice",
    Astro.site!,
  )}
  title={`${messages.legal_notice_title({}, { locale })} | ${messages.site_title({}, { locale })}`}
>
  <LegalNoticeDetail catalog={catalog} locale={locale} />
</PublicLayout>
