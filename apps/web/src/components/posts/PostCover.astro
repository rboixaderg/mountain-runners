---
import { getPostCover, type PostVariant } from "../../lib/content/posts";
import {
  getPostImageHref,
  transformPostImage,
} from "../../lib/content/post-images";
interface Props {
  variant: PostVariant;
}
const { entry, locale } = Astro.props.variant;
const cover = getPostCover(entry, locale);
const image = cover && (await transformPostImage(cover.resource.path, 1200));
---

{
  cover && image && (
    <figure class="page-frame my-8">
      <picture>
        <source
          media="(max-width: 480px)"
          srcset={getPostImageHref(cover.resource.path, 480)}
        />
        <img
          class="max-w-reading h-auto w-full"
          src={getPostImageHref(cover.resource.path, 1200)}
          width={image.info.width}
          height={image.info.height}
          alt={cover.alt[locale]!}
          decoding="async"
        />
      </picture>
      <figcaption class="text-muted mt-2 text-sm">
        {cover.attribution[locale]}
      </figcaption>
    </figure>
  )
}
