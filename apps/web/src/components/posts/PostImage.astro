---
import type { PostImage } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import {
  getPostImageHref,
  transformPostImage,
} from "../../lib/content/post-images";
import * as messages from "../../paraglide/messages";
interface Props {
  image: PostImage;
  locale: Locale;
  loading: "eager" | "lazy";
  isCover?: boolean;
  zoomHref?: string;
}
const { image, locale, loading, isCover = false, zoomHref } = Astro.props;
const { info } = await transformPostImage(image.resource.path, 1200);
// The zoom link must wrap only the picture: WCAG 2.5.3 requires the visible
// text of a control to be part of its accessible name, and the caption is not.
const Media = zoomHref ? "a" : Fragment;
const zoomAttributes = zoomHref
  ? {
      class: "block cursor-zoom-in",
      href: zoomHref,
      "aria-label": messages.post_image_enlarge(
        { description: image.alt[locale]! },
        { locale },
      ),
    }
  : undefined;
---

<figure class="m-0 min-w-0">
  <Media {...zoomAttributes}>
    <picture>
      <source
        media="(max-width: 480px)"
        srcset={getPostImageHref(image.resource.path, 480)}
      />
      <img
        class:list={[
          isCover
            ? "aspect-video max-h-80 w-full object-contain"
            : "mx-auto h-auto max-h-120 w-auto max-w-full object-contain",
        ]}
        src={getPostImageHref(image.resource.path, 1200)}
        width={info.width}
        height={info.height}
        alt={image.alt[locale]!}
        loading={loading}
        decoding="async"
      />
    </picture>
  </Media>
  <figcaption class="text-muted mt-2 text-sm">
    {image.caption && <p class="m-0">{image.caption[locale]}</p>}
    {image.attribution[locale]}
  </figcaption>
</figure>
