---
import type { PostVariant } from "../../lib/content/posts";
import type { PublishedVariant } from "../../lib/content/publication";
import { getFixedPagePath, getVariantPath } from "../../lib/content/routes";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import { formatPostDate } from "../../lib/presentation/posts";
import { externalLinkAttributes } from "../../lib/presentation/urls";
import * as messages from "../../paraglide/messages.js";
import PageSection from "../PageSection.astro";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../../lib/analytics/catalog";
interface Props {
  variant: PostVariant;
  relatedEvents: Extract<PublishedVariant, { kind: "event" }>[];
}
const {
  variant: { entry, locale },
  relatedEvents,
} = Astro.props;
const sources = (entry.sources ?? []).filter((source) => source.name[locale]);
const correction = entry.correction?.note[locale]
  ? entry.correction
  : undefined;
---

{entry.relatedPage && (
  <div class="page-frame pb-section">
    <a
      class="action-underline"
      href={getFixedPagePath(entry.relatedPage, locale)}
      {...analyticsActionAttributes({
        action: analyticsActions.navigate,
        area: analyticsAreas.postResources,
        target: entry.relatedPage,
      })}
    >
      {messages.posts_members_link({}, { locale })}
    </a>
  </div>
)}
{correction && (
  <PageSection
    title={messages.posts_correction({}, { locale })}
    id="post-correction"
  >
    <time datetime={correction.date}>
      {formatPostDate(correction.date, locale)}
    </time>
    <div set:html={renderRestrictedMarkdown(correction.note[locale]!)} />
  </PageSection>
)}
{sources.length > 0 && (
  <PageSection title={messages.posts_sources({}, { locale })} id="post-sources">
    <ul>
      {sources.map((source) => (
        <li>
          <a href={source.url} {...externalLinkAttributes}>
            {source.name[locale]}
          </a>
        </li>
      ))}
    </ul>
  </PageSection>
)}
{relatedEvents.length > 0 && (
  <PageSection
    title={messages.posts_related_events({}, { locale })}
    id="post-events"
  >
    <ul>
      {relatedEvents.map((event) => (
        <li>
          <a
            href={getVariantPath(event)}
            {...analyticsActionAttributes({
              action: analyticsActions.navigate,
              area: analyticsAreas.postResources,
              target: event.entry.id,
            })}
          >
            {event.entry.title[locale]}
          </a>
        </li>
      ))}
    </ul>
  </PageSection>
)}
