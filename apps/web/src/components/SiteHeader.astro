---
import * as messages from "../paraglide/messages.js";
import logo from "../assets/logo_mountain_runners.png";
import type { Locale } from "../lib/content/primitives";
import { getDomainPath, getFixedPagePath } from "../lib/content/routes";
import LanguageSelector from "./LanguageSelector.astro";

type LocalizedAlternative = { locale: Locale; href: string };

interface Props {
  localizedAlternatives: LocalizedAlternative[];
  locale: Locale;
}

const { localizedAlternatives, locale } = Astro.props;
const homePath = `/${locale}/`;
const eventsPath = getDomainPath("event", locale);
const schoolsPath = getDomainPath("school", locale);
const aboutPath = getFixedPagePath("about", locale);
const membersPath = getFixedPagePath("members", locale);
---

<header class="border-b border-[var(--color-line)]">
  <div class="page-frame flex min-h-18 items-center gap-6">
    <a
      class="shrink-0 no-underline"
      href={homePath}
      aria-label={messages.site_title({}, { locale })}
    >
      <img
        class="site-logo"
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt=""
      />
    </a>
    <nav
      class="ml-auto hidden items-center gap-4 text-sm md:flex"
      aria-label={messages.primary_navigation({}, { locale })}
    >
      <a class="font-bold" href={homePath}
        >{messages.navigation_home({}, { locale })}</a
      >
      <a class="font-bold" href={eventsPath}
        >{messages.navigation_events({}, { locale })}</a
      >
      <a class="font-bold" href={aboutPath}
        >{messages.navigation_about({}, { locale })}</a
      >
      <a class="font-bold" href={membersPath}
        >{messages.navigation_members({}, { locale })}</a
      >
      <a class="font-bold" href={schoolsPath}
        >{messages.navigation_schools({}, { locale })}</a
      >
    </nav>
    <div class="hidden md:block">
      <LanguageSelector
        localizedAlternatives={localizedAlternatives}
        locale={locale}
      />
    </div>
    <details class="relative ml-auto md:hidden">
      <summary class="cursor-pointer font-bold"
        >{messages.menu({}, { locale })}</summary
      >
      <div
        class="absolute right-0 z-10 mt-4 min-w-60 border border-[var(--color-line)] bg-[var(--color-paper)] p-4 shadow-sm"
      >
        <nav
          class="grid gap-3"
          aria-label={messages.primary_navigation({}, { locale })}
        >
          <a class="font-bold" href={homePath}
            >{messages.navigation_home({}, { locale })}</a
          >
          <a class="font-bold" href={eventsPath}
            >{messages.navigation_events({}, { locale })}</a
          >
          <a class="font-bold" href={aboutPath}
            >{messages.navigation_about({}, { locale })}</a
          >
          <a class="font-bold" href={membersPath}
            >{messages.navigation_members({}, { locale })}</a
          >
          <a class="font-bold" href={schoolsPath}
            >{messages.navigation_schools({}, { locale })}</a
          >
        </nav>
        <div class="mt-4">
          <LanguageSelector
            localizedAlternatives={localizedAlternatives}
            locale={locale}
          />
        </div>
      </div>
    </details>
  </div>
</header>
