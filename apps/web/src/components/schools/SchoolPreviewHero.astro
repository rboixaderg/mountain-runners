---
import * as messages from "../../paraglide/messages.js";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import type { School } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";

interface Props {
  locale: Locale;
  school: School;
}

const { locale, school } = Astro.props;
const coverHref = getResourceHref(school.cover.resource);
const coverSize =
  school.cover.resource.kind === "local"
    ? await getLocalImageSize(school.cover.resource.path)
    : undefined;
---

<header
  class="schools-detail-preview__hero border-ink bg-ink relative grid place-items-center overflow-hidden border-b-2 text-white"
>
  <figure
    class="schools-detail-preview__hero-cover bg-red absolute inset-0 m-0 border-0"
  >
    <img
      src={coverHref}
      class="size-full object-cover mix-blend-multiply"
      alt=""
      loading="eager"
      decoding="async"
      {...coverSize === undefined
        ? {}
        : { width: coverSize.width, height: coverSize.height }}
    />
  </figure>
  <div class="schools-detail-preview__hero-overlay" aria-hidden="true"></div>
  <div
    class="page-frame schools-detail-preview__hero-content relative z-1 grid justify-items-center text-center"
  >
    <p
      class="schools-detail-preview__hero-kicker font-display bg-ink text-meta m-0 mb-4 -rotate-1 border-0 leading-normal font-bold tracking-widest text-white uppercase"
    >
      {messages.navigation_schools({}, { locale })}
    </p>
    <h1
      class="schools-detail-preview__hero-title font-display leading-display m-0 uppercase"
    >
      {school.name[locale]!}
    </h1>
    <p class="schools-detail-preview__hero-summary m-0 mt-4 max-w-xl">
      {school.summary[locale]}
    </p>
  </div>
  <div class="schools-detail-preview__hero-edge" aria-hidden="true"></div>
</header>
