---
import * as messages from "../../paraglide/messages.js";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import type { School } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";

interface Props {
  locale: Locale;
  school: School;
}

const { locale, school } = Astro.props;
const galleryImages = await Promise.all(
  school.gallery.map(async (image) => ({
    image,
    href: getResourceHref(image.resource),
    size:
      image.resource.kind === "local"
        ? await getLocalImageSize(image.resource.path)
        : undefined,
  })),
);
---

{
  galleryImages.length > 0 && (
    <section
      class="schools-detail-preview__gallery"
      aria-labelledby="school-gallery-title"
    >
      <div class="page-frame">
        <div class="schools-detail-preview__gallery-heading">
          <span
            class="schools-detail-preview__gallery-marker"
            aria-hidden="true"
          />
          <h2 id="school-gallery-title">
            {messages.school_gallery_title({}, { locale })}
          </h2>
        </div>
        <ul class="schools-detail-preview__gallery-list">
          {galleryImages.map(({ image, href, size }) => (
            <li class="schools-detail-preview__gallery-item">
              <figure>
                <img
                  src={href}
                  alt={image.alt[locale]}
                  loading="lazy"
                  decoding="async"
                  {...(size === undefined
                    ? {}
                    : { width: size.width, height: size.height })}
                />
                {image.attribution?.[locale] && (
                  <figcaption>{image.attribution[locale]}</figcaption>
                )}
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
