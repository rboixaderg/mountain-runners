---
import * as messages from "../../paraglide/messages.js";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import type { School } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";

interface Props {
  locale: Locale;
  school: School;
}

const { locale, school } = Astro.props;
const galleryImages = await Promise.all(
  school.gallery.map(async (image) => ({
    image,
    href: getResourceHref(image.resource),
    size:
      image.resource.kind === "local"
        ? await getLocalImageSize(image.resource.path)
        : undefined,
  })),
);
---

{
  galleryImages.length > 0 && (
    <section
      class="schools-detail-preview__gallery border-line bg-stone border-b"
      aria-labelledby="school-gallery-title"
    >
      <div class="page-frame">
        <div class="schools-detail-preview__gallery-heading flex items-center gap-2">
          <span class="bg-red h-6 w-2 flex-none" aria-hidden="true" />
          <h2 class="font-display m-0 uppercase" id="school-gallery-title">
            {messages.school_gallery_title({}, { locale })}
          </h2>
        </div>
        <ul class="schools-detail-preview__gallery-list m-0 grid list-none grid-cols-2 p-0 md:grid-cols-3">
          {galleryImages.map(({ image, href, size }) => (
            <li class="schools-detail-preview__gallery-item">
              <figure class="border-ink m-0 border-2 bg-white">
                <img
                  class="block aspect-4/3 w-full object-cover"
                  src={href}
                  alt={image.alt[locale]}
                  loading="lazy"
                  decoding="async"
                  {...(size === undefined
                    ? {}
                    : { width: size.width, height: size.height })}
                />
                {image.attribution?.[locale] && (
                  <figcaption class="text-muted mt-2 text-center font-bold uppercase">
                    {image.attribution[locale]}
                  </figcaption>
                )}
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
