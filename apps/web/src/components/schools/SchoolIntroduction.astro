---
import * as messages from "../../paraglide/messages.js";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import type { School } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import DetailHero from "../DetailHero.astro";

interface Props {
  locale: Locale;
  school: School;
}

const { locale, school } = Astro.props;
const coverHref = getResourceHref(school.cover.resource);
const coverSize =
  school.cover.resource.kind === "local"
    ? await getLocalImageSize(school.cover.resource.path)
    : undefined;
---

<DetailHero
  coverAlt={school.cover.alt[locale]!}
  coverAttribution={school.cover.attribution?.[locale]}
  coverHeight={coverSize?.height}
  coverHref={coverHref}
  coverWidth={coverSize?.width}
  kicker={messages.navigation_schools({}, { locale })}
  title={school.name[locale]!}
/>

<style>
  .schools-detail__description :global(:first-child) {
    margin-top: 0;
  }

  .schools-detail__description :global(:last-child) {
    margin-bottom: 0;
  }
</style>

<section
  class="page-frame schools-detail__intro bg-ink text-paper grid items-center gap-10 py-[var(--section-space)] md:grid-cols-[minmax(0,0.9fr)_minmax(18rem,1.1fr)] md:gap-16"
>
  <div class="schools-detail__intro-copy">
    <h2 class="schools-detail__summary">{school.summary[locale]}</h2>
    <div
      class="schools-detail__description"
      set:html={renderRestrictedMarkdown(school.description[locale]!)}
    />
  </div>
  <figure class="schools-detail__intro-image">
    <img
      src={coverHref}
      alt=""
      loading="lazy"
      decoding="async"
      {...coverSize === undefined
        ? {}
        : { width: coverSize.width, height: coverSize.height }}
    />
  </figure>
</section>
