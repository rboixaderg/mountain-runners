---
import * as messages from "../../paraglide/messages.js";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import type { School } from "../../lib/content/models";
import { getDomainPath } from "../../lib/content/routes";
import type { Locale } from "../../lib/content/primitives";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";

interface Props {
  locale: Locale;
  school: School;
}

const { locale, school } = Astro.props;
const coverHref = getResourceHref(school.cover.resource);
const coverSize =
  school.cover.resource.kind === "local"
    ? await getLocalImageSize(school.cover.resource.path)
    : undefined;
---

<section class="schools-detail__intro">
  <div class="schools-detail__intro-grid">
    <div class="page-frame schools-detail__intro-copy">
      <a
        class="schools-detail__back-link"
        href={getDomainPath("school", locale)}
      >
        <span aria-hidden="true">←</span>
        {messages.school_back_to_hub({}, { locale })}
      </a>
      <p class="schools-detail__kicker">
        {messages.navigation_schools({}, { locale })}
      </p>
      <h1 class="schools-detail__title">{school.name[locale]}</h1>
      <p class="schools-detail__summary">{school.summary[locale]}</p>
      <div
        class="schools-detail__description"
        set:html={renderRestrictedMarkdown(school.description[locale]!)}
      />
    </div>
    <figure class="schools-detail__cover">
      <img
        src={coverHref}
        alt={school.cover.alt[locale]}
        {...coverSize === undefined
          ? {}
          : { width: coverSize.width, height: coverSize.height }}
      />
      {
        school.cover.attribution?.[locale] && (
          <figcaption>{school.cover.attribution[locale]}</figcaption>
        )
      }
    </figure>
  </div>
</section>
