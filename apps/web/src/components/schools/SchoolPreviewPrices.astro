---
import * as messages from "../../paraglide/messages.js";
import type { Locale } from "../../lib/content/primitives";
import {
  hasPreviewPriceContent,
  formatPriceAmount,
  parsePreviewPriceSection,
  parseSchoolPracticalSection,
} from "../../lib/presentation/schools";
import SchoolPracticalIcon from "./SchoolPracticalIcon.astro";

interface Props {
  locale: Locale;
  pricesMarkdown: string;
}

const { locale, pricesMarkdown } = Astro.props;
const parsedSection = parseSchoolPracticalSection(pricesMarkdown);
const priceSection = parsePreviewPriceSection(parsedSection.body);
const priceTiers = [...priceSection.listedFees, ...priceSection.monthlyTiers];

if (!hasPreviewPriceContent(pricesMarkdown)) {
  return null;
}
---

<article
  class="border-ink p-card shadow-action-lg flex min-w-0 flex-col border-2 bg-white"
>
  <div class="schools-detail-preview__prices-header flex items-start gap-4">
    <div class="bg-ink inline-flex p-3 text-white" aria-hidden="true">
      <SchoolPracticalIcon sectionKey="prices" />
    </div>
    <div class="min-w-0">
      <h3
        class="schools-detail-preview__practical-card-title font-display text-ink leading-action tracking-display m-0 font-bold uppercase"
      >
        {messages.school_prices_label({}, { locale })}
      </h3>
      {
        parsedSection.lead && (
          <p class="schools-detail-preview__prices-intro text-muted m-0 mt-2">
            {parsedSection.lead}
          </p>
        )
      }
    </div>
  </div>

  <div class="grid gap-5">
    {
      priceTiers.length > 0 && (
        <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-3">
          {priceTiers.map((priceTier) => {
            const formattedAmount = formatPriceAmount(priceTier.amount);

            return (
              <li class="schools-detail-preview__price-tier border-ink bg-stone shadow-action-accent grid justify-items-center border-2 text-center">
                <span class="text-muted tracking-label text-xs leading-normal font-bold uppercase">
                  {priceTier.label}
                </span>
                <span class="schools-detail-preview__price-tier-value font-display text-red mt-2 leading-none font-bold">
                  {formattedAmount.value}
                </span>
                {formattedAmount.unit.length > 0 && (
                  <span class="schools-detail-preview__price-tier-unit text-ink font-semibold">
                    {formattedAmount.unit}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      )
    }

    {
      priceSection.registrationFees.length > 0 && (
        <div class="schools-detail-preview__price-registration grid gap-3 pt-5">
          <h4 class="schools-detail-preview__price-registration-title font-display text-ink tracking-label m-0 font-bold uppercase">
            {messages.school_prices_registration_label({}, { locale })}
          </h4>
          <ul class="m-0 grid list-none gap-2 p-0 md:grid-cols-2">
            {priceSection.registrationFees.map((registrationFee) => (
              <li class="schools-detail-preview__price-registration-item bg-stone flex flex-wrap items-baseline justify-between">
                <span class="schools-detail-preview__price-registration-label min-w-0 font-semibold">
                  {registrationFee.label}
                </span>
                <span class="schools-detail-preview__price-registration-amount font-display text-red min-w-0 text-end font-bold wrap-anywhere">
                  {registrationFee.amount}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      priceSection.footnote && (
        <p class="schools-detail-preview__prices-footnote text-muted m-0 leading-normal">
          {priceSection.footnote}
        </p>
      )
    }
  </div>
</article>
