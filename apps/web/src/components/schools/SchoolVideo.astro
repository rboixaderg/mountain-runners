---
import * as messages from "../../paraglide/messages.js";
import type { School } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import { extractYoutubeVideoId } from "../../lib/presentation/youtube";
import ExternalLink from "../ExternalLink.astro";
import YoutubeEmbed from "../YoutubeEmbed.astro";

interface Props {
  locale: Locale;
  school: School;
}

const { locale, school } = Astro.props;
const videoUrl = school.promotionalVideoUrl;
const videoId =
  videoUrl === undefined ? undefined : extractYoutubeVideoId(videoUrl);
---

{
  videoId !== undefined && (
    <section
      class="border-ink py-section border-b-2 bg-white"
      aria-labelledby="school-video-title"
    >
      <div class="page-frame">
        <div class="schools-detail-preview__video-heading flex items-center gap-2">
          <span class="bg-red h-6 w-2 flex-none" aria-hidden="true" />
          <h2 class="font-display m-0 uppercase" id="school-video-title">
            {messages.school_video_title({}, { locale })}
          </h2>
        </div>
        <YoutubeEmbed
          className="max-w-reading shadow-action-lg"
          title={messages.school_video_title({}, { locale })}
          videoId={videoId}
        />
        {videoUrl && (
          <ExternalLink
            className="schools-detail-preview__video-link text-red mt-4 inline-flex max-w-full items-center text-xs leading-normal font-bold tracking-display uppercase"
            href={videoUrl}
            label={messages.school_video_action({}, { locale })}
          />
        )}
      </div>
    </section>
  )
}
