---
import * as messages from "../../paraglide/messages.js";
import type { School } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import {
  schoolPracticalSectionMessageKeys,
  schoolPracticalSectionOrder,
} from "../../lib/presentation/schools";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import SchoolPracticalIcon from "./SchoolPracticalIcon.astro";

interface Props {
  locale: Locale;
  school: School;
}

const { locale, school } = Astro.props;
const practicalSections = schoolPracticalSectionOrder.filter(
  (sectionKey) => school.sections[sectionKey]?.[locale] !== undefined,
);
---

<section
  class="schools-detail__section schools-detail__practical"
  aria-labelledby="school-practical-title"
>
  <div
    class="schools-detail__section-heading schools-detail__practical-heading"
  >
    <h2 id="school-practical-title">
      {messages.school_practical_info_title({}, { locale })}
    </h2>
  </div>
  <ul class="schools-detail__practical-grid">
    {
      practicalSections.map((sectionKey) => (
        <li
          class:list={[
            "schools-detail__practical-card",
            sectionKey === "schedule" &&
              "schools-detail__practical-card--featured",
            sectionKey === "location" &&
              "schools-detail__practical-card--location",
          ]}
        >
          <div class="schools-detail__practical-icon" aria-hidden="true">
            <SchoolPracticalIcon sectionKey={sectionKey} />
          </div>
          <h3 class="schools-detail__practical-card-title">
            {messages[schoolPracticalSectionMessageKeys[sectionKey]](
              {},
              { locale },
            )}
          </h3>
          <div
            class="schools-detail__practical-card-body"
            set:html={renderRestrictedMarkdown(
              school.sections[sectionKey]![locale]!,
            )}
          />
          {sectionKey === "location" && (
            <svg
              class="schools-detail__practical-watermark"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill="currentColor"
                d="M14 6l-4.22 5.63 1.25 1.67L14.6 8.4l4.4 5.87 1.6-1.2L14 6zm-2-4L2 9v13h20V9L12 2zm8 18H4v-9.5l8-6 8 6V20z"
              />
            </svg>
          )}
        </li>
      ))
    }
  </ul>
</section>
