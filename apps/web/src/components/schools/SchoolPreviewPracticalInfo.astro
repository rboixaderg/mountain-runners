---
import * as messages from "../../paraglide/messages.js";
import type { School } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import {
  extractLocationParts,
  extractScheduleParts,
  hasPreviewPriceContent,
  hasPreviewPracticalCardContent,
  isCompactSchedulePreview,
  orderPreviewEssentialSections,
  parseSchoolPracticalSection,
  schoolPracticalPreviewContextOrder,
  schoolPracticalPreviewEssentialOrder,
  schoolPracticalSectionMessageKeys,
  type SchoolPracticalSectionKey,
} from "../../lib/presentation/schools";
import SchoolPreviewPrices from "./SchoolPreviewPrices.astro";
import SchoolPracticalIcon from "./SchoolPracticalIcon.astro";

interface Props {
  locale: Locale;
  school: School;
}

const { locale, school } = Astro.props;

function sectionContent(
  sectionKey: SchoolPracticalSectionKey,
): string | undefined {
  return school.sections[sectionKey]?.[locale];
}

const essentialSections = orderPreviewEssentialSections(
  schoolPracticalPreviewEssentialOrder.filter((sectionKey) =>
    hasPreviewPracticalCardContent(sectionKey, sectionContent(sectionKey)),
  ),
  sectionContent,
);
const contextSections = schoolPracticalPreviewContextOrder.filter(
  (sectionKey) =>
    hasPreviewPracticalCardContent(sectionKey, sectionContent(sectionKey)),
);
const pricesMarkdown = sectionContent("prices");
const hasPrices =
  pricesMarkdown !== undefined && hasPreviewPriceContent(pricesMarkdown);
const hasPracticalContent =
  essentialSections.length > 0 || contextSections.length > 0 || hasPrices;
---

{
  hasPracticalContent && (
    <section
      class="schools-detail-preview__practical border-ink bg-stone relative z-0 border-y-2"
      aria-labelledby="school-preview-practical-title"
    >
      <div class="page-frame schools-detail-preview__practical-header">
        <h2
          class="schools-detail-preview__practical-title font-display border-red m-0 mb-4 inline-block border-b-4 pb-2 uppercase"
          id="school-preview-practical-title"
        >
          {messages.school_practical_info_title({}, { locale })}
        </h2>
        <p class="schools-detail-preview__practical-intro text-muted m-0">
          {messages.school_practical_info_intro({}, { locale })}
        </p>
      </div>

      <div class="page-frame schools-detail-preview__practical-layout grid min-w-0">
        {essentialSections.length > 0 && (
          <ul class="schools-detail-preview__practical-grid schools-detail-preview__practical-grid--essentials m-0 grid list-none grid-cols-1 p-0 md:grid-cols-3">
            {essentialSections.map((sectionKey) => {
              const parsedSection = parseSchoolPracticalSection(
                sectionContent(sectionKey)!,
              );
              const scheduleParts =
                sectionKey === "schedule" &&
                isCompactSchedulePreview(parsedSection)
                  ? extractScheduleParts(parsedSection.lead!)
                  : null;
              const locationParts =
                sectionKey === "location" && parsedSection.lead
                  ? extractLocationParts(parsedSection.lead)
                  : null;

              const isDetailedSchedule =
                sectionKey === "schedule" &&
                !isCompactSchedulePreview(parsedSection);

              return (
                <li
                  class:list={[
                    "schools-detail-preview__practical-card",
                    isDetailedSchedule &&
                      "schools-detail-preview__practical-card--schedule-detailed md:col-span-full",
                    "border-ink relative flex h-full min-w-0 flex-col items-start overflow-hidden border-2 bg-white",
                  ]}
                >
                  <div class="schools-detail-preview__practical-card-top mb-4 flex flex-col items-start gap-5">
                    <div
                      class="schools-detail-preview__practical-icon bg-ink inline-flex p-3 text-white"
                      aria-hidden="true"
                    >
                      <SchoolPracticalIcon sectionKey={sectionKey} />
                    </div>
                    <h3 class="schools-detail-preview__practical-card-title font-display text-ink m-0 font-bold uppercase">
                      {messages[schoolPracticalSectionMessageKeys[sectionKey]](
                        {},
                        { locale },
                      )}
                    </h3>
                  </div>
                  <div class="schools-detail-preview__practical-card-content w-full flex-1">
                    {sectionKey === "schedule" && scheduleParts ? (
                      <>
                        {parsedSection.label && (
                          <p class="schools-detail-preview__practical-card-label text-muted text-xs leading-normal font-bold uppercase">
                            {parsedSection.label}
                          </p>
                        )}
                        <p class="schools-detail-preview__practical-card-primary text-ink m-0 text-base leading-normal font-semibold">
                          {scheduleParts.days}
                        </p>
                        {scheduleParts.time && (
                          <p class="schools-detail-preview__practical-card-highlight font-display text-red font-bold">
                            {scheduleParts.time}
                          </p>
                        )}
                        {parsedSection.body.length > 0 && (
                          <p class="schools-detail-preview__practical-card-note text-muted leading-normal">
                            {parsedSection.body}
                          </p>
                        )}
                      </>
                    ) : sectionKey === "schedule" && isDetailedSchedule ? (
                      <div
                        class="schools-detail-preview__practical-card-body text-ink mt-3 w-full"
                        set:html={renderRestrictedMarkdown(
                          sectionContent(sectionKey)!,
                        )}
                      />
                    ) : sectionKey === "location" && locationParts ? (
                      <>
                        <p class="schools-detail-preview__practical-card-primary text-ink m-0 text-base leading-normal font-semibold">
                          {locationParts.primary}
                        </p>
                        {locationParts.secondary && (
                          <p class="schools-detail-preview__practical-card-note text-muted leading-normal">
                            {locationParts.secondary}
                          </p>
                        )}
                      </>
                    ) : (
                      parsedSection.lead && (
                        <p class="schools-detail-preview__practical-card-highlight font-display text-red font-bold">
                          {parsedSection.lead}
                        </p>
                      )
                    )}
                  </div>
                  {sectionKey === "location" && (
                    <svg
                      class="schools-detail-preview__practical-watermark"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="currentColor"
                        d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                      />
                    </svg>
                  )}
                </li>
              );
            })}
          </ul>
        )}

        {hasPrices && pricesMarkdown && (
          <SchoolPreviewPrices
            locale={locale}
            pricesMarkdown={pricesMarkdown}
          />
        )}

        {contextSections.length > 0 && (
          <ul class="schools-detail-preview__practical-grid schools-detail-preview__practical-grid--context m-0 grid list-none grid-cols-1 p-0 md:grid-cols-2">
            {contextSections.map((sectionKey) => {
              const parsedSection = parseSchoolPracticalSection(
                sectionContent(sectionKey)!,
              );

              return (
                <li
                  class:list={[
                    "schools-detail-preview__practical-card",
                    "schools-detail-preview__practical-card--context",
                    "border-ink relative flex h-full min-w-0 flex-col items-start overflow-hidden border-2 bg-white",
                  ]}
                >
                  <div class="schools-detail-preview__practical-card-top mb-4 flex flex-col items-start gap-5">
                    <div
                      class="schools-detail-preview__practical-icon bg-ink inline-flex p-3 text-white"
                      aria-hidden="true"
                    >
                      <SchoolPracticalIcon sectionKey={sectionKey} />
                    </div>
                    <h3 class="schools-detail-preview__practical-card-title font-display text-ink m-0 font-bold uppercase">
                      {messages[schoolPracticalSectionMessageKeys[sectionKey]](
                        {},
                        { locale },
                      )}
                    </h3>
                  </div>
                  <div class="schools-detail-preview__practical-card-content w-full flex-1">
                    {parsedSection.lead && (
                      <p class="schools-detail-preview__practical-card-primary text-ink m-0 text-base leading-normal font-semibold">
                        {parsedSection.lead}
                      </p>
                    )}
                    {parsedSection.body.length > 0 && (
                      <div
                        class="schools-detail-preview__practical-card-body text-ink mt-3 w-full"
                        set:html={renderRestrictedMarkdown(parsedSection.body)}
                      />
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .schools-detail-preview__practical-card-body > :global(:first-child) {
    margin-top: 0;
  }

  .schools-detail-preview__practical-card-body > :global(:last-child) {
    margin-bottom: 0;
  }

  .schools-detail-preview__practical-card-body :global(strong) {
    color: var(--color-red);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .schools-detail-preview__practical-card-body :global(ul) {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .schools-detail-preview__practical-card-body :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    border: 0.0625rem solid rgb(23 23 23 / 0.12);
    padding: 0.55rem 0.75rem;
    background: var(--color-stone);
  }

  .schools-detail-preview__practical-card-body :global(li p) {
    margin: 0;
    font-weight: 600;
  }

  .schools-detail-preview__practical-card-body :global(p + p) {
    margin-top: 0.65rem;
  }

  .schools-detail-preview__practical-card-body :global(p:last-child) {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
