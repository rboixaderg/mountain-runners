---
import type { Locale } from "../../lib/content/primitives";
import type { PublishedVariant } from "../../lib/content/publication";
import SchoolPreviewAbout from "./SchoolPreviewAbout.astro";
import SchoolPreviewHero from "./SchoolPreviewHero.astro";
import SchoolPreviewPracticalInfo from "./SchoolPreviewPracticalInfo.astro";
import SchoolRegistration from "./SchoolRegistration.astro";
import "../../styles/school-detail.css";
import "../../styles/school-detail-preview.css";

interface Props {
  locale: Locale;
  variant: Extract<PublishedVariant, { kind: "school" }>;
}

const { locale, variant } = Astro.props;
const school = variant.entry;
---

<div class="schools-detail">
  <SchoolPreviewHero locale={locale} school={school} />
  <SchoolPreviewAbout locale={locale} school={school} />
  <SchoolPreviewPracticalInfo locale={locale} school={school} />
  <div class="schools-detail-preview__registration">
    <SchoolRegistration locale={locale} school={school} />
  </div>
</div>
