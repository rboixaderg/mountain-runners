---
import type { Locale } from "../../lib/content/primitives";
import type { PublishedVariant } from "../../lib/content/publication";
import SchoolIntroduction from "./SchoolIntroduction.astro";
import SchoolPracticalInfo from "./SchoolPracticalInfo.astro";
import SchoolRegistration from "./SchoolRegistration.astro";

interface Props {
  locale: Locale;
  variant: Extract<PublishedVariant, { kind: "school" }>;
}

const { locale, variant } = Astro.props;
const school = variant.entry;
---

<article class="schools-detail">
  <SchoolIntroduction locale={locale} school={school} />
  <div class="page-frame schools-detail__body">
    <SchoolPracticalInfo locale={locale} school={school} />
  </div>
  <SchoolRegistration locale={locale} school={school} />
</article>
