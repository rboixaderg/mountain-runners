---
import * as messages from "../../paraglide/messages.js";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { School } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import { hasSchoolSectionContent } from "../../lib/presentation/schools";

interface Props {
  locale: Locale;
  school: School;
}

const { locale, school } = Astro.props;
const description = school.description[locale];

if (!hasSchoolSectionContent(description)) {
  return null;
}

const coverHref = getResourceHref(school.cover.resource);
const coverSize =
  school.cover.resource.kind === "local"
    ? await getLocalImageSize(school.cover.resource.path)
    : undefined;
---

<section
  class="page-frame schools-detail-preview__about py-section grid items-center"
  aria-labelledby="school-preview-about-title"
>
  <div class="min-w-0">
    <h2
      class="schools-detail-preview__about-title font-display m-0 mb-5 uppercase"
      id="school-preview-about-title"
    >
      {messages.school_preview_about_title({}, { locale })}
    </h2>
    <div
      class="schools-detail-preview__about-body text-ink max-w-reading"
      set:html={renderRestrictedMarkdown(description!)}
    />
  </div>
  <figure class="schools-detail-preview__about-media relative">
    <div class="schools-detail-preview__about-media-accent" aria-hidden="true">
    </div>
    <div
      class="border-ink relative z-1 rotate-2 overflow-hidden border-2 bg-white p-2"
    >
      <img
        class="aspect-square w-full object-cover"
        src={coverHref}
        alt={school.cover.alt[locale]!}
        loading="lazy"
        decoding="async"
        {...coverSize === undefined
          ? {}
          : { width: coverSize.width, height: coverSize.height }}
      />
    </div>
  </figure>
</section>

<style>
  .schools-detail-preview__about-body :global(:first-child) {
    margin-top: 0;
  }

  .schools-detail-preview__about-body :global(:last-child) {
    margin-bottom: 0;
  }

  .schools-detail-preview__about-body :global(p + p) {
    margin-top: 1rem;
  }
</style>
