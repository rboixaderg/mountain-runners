---
import type { Locale } from "../lib/content/primitives";
import * as messages from "../paraglide/messages.js";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<aside class="bg-ink px-4 py-3 text-center font-bold text-white">
  {messages.preview_notice({}, { locale })}
</aside>
