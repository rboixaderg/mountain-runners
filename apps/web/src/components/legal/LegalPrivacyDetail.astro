---
import homepageHero from "../../assets/home/homepage-hero.jpeg";
import homepageHeroSmall from "../../assets/home/homepage-hero-mobile.jpeg";
import * as messages from "../../paraglide/messages.js";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { PublicationCatalog } from "../../lib/content/publication";
import type { Locale } from "../../lib/content/primitives";
import { getMarkdownSafeEmailAddress } from "../../lib/presentation/urls";
import ContactDataList from "../ContactDataList.astro";
import PageIntro from "../PageIntro.astro";
import PageSection from "../PageSection.astro";

type LegalPrivacySection = {
  id: string;
  titleKey:
    | "legal_privacy_purposes_title"
    | "legal_privacy_legal_basis_title"
    | "legal_privacy_recipients_title"
    | "legal_privacy_hosting_title"
    | "legal_privacy_rights_title"
    | "legal_privacy_updates_title";
  bodyKey:
    | "legal_privacy_purposes"
    | "legal_privacy_legal_basis"
    | "legal_privacy_recipients"
    | "legal_privacy_hosting"
    | "legal_privacy_rights"
    | "legal_privacy_updates";
};

const legalPrivacySections: LegalPrivacySection[] = [
  {
    id: "legal-privacy-purposes",
    titleKey: "legal_privacy_purposes_title",
    bodyKey: "legal_privacy_purposes",
  },
  {
    id: "legal-privacy-legal-basis",
    titleKey: "legal_privacy_legal_basis_title",
    bodyKey: "legal_privacy_legal_basis",
  },
  {
    id: "legal-privacy-recipients",
    titleKey: "legal_privacy_recipients_title",
    bodyKey: "legal_privacy_recipients",
  },
  {
    id: "legal-privacy-hosting",
    titleKey: "legal_privacy_hosting_title",
    bodyKey: "legal_privacy_hosting",
  },
  {
    id: "legal-privacy-rights",
    titleKey: "legal_privacy_rights_title",
    bodyKey: "legal_privacy_rights",
  },
  {
    id: "legal-privacy-updates",
    titleKey: "legal_privacy_updates_title",
    bodyKey: "legal_privacy_updates",
  },
];

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
}

const { catalog, locale } = Astro.props;
const contact = catalog.contact;
const institutionalEmail = contact?.email
  ? getMarkdownSafeEmailAddress(contact.email)
  : undefined;

const visibleLegalPrivacySections = legalPrivacySections.flatMap((section) => {
  if (section.bodyKey === "legal_privacy_rights") {
    return [
      {
        ...section,
        body:
          institutionalEmail === undefined
            ? messages.legal_privacy_rights_without_email({}, { locale })
            : messages.legal_privacy_rights({ institutionalEmail }, { locale }),
      },
    ];
  }

  return [
    {
      ...section,
      body: messages[section.bodyKey]({}, { locale }),
    },
  ];
});
---

<article class="page-detail pb-0">
  <PageIntro
    description={messages.legal_privacy_description({}, { locale })}
    heroImage={homepageHeroSmall}
    heroImageLarge={homepageHero}
    kicker={messages.site_title({}, { locale })}
    title={messages.legal_privacy_title({}, { locale })}
  />
  <PageSection
    id="legal-privacy-responsible"
    title={messages.legal_privacy_responsible_title({}, { locale })}
  >
    {
      contact && (
        <ContactDataList
          addressLabelKey="legal_entity_address_label"
          contact={contact}
          locale={locale}
        />
      )
    }
  </PageSection>
  {
    visibleLegalPrivacySections.map(({ body, id, titleKey }) => (
      <PageSection id={id} title={messages[titleKey]({}, { locale })}>
        <div
          class="page-section__markdown"
          set:html={renderRestrictedMarkdown(body)}
        />
      </PageSection>
    ))
  }
</article>
