---
import type { ImageMetadata } from "astro";
import PageHero from "./PageHero.astro";
import PageHeroMedia from "./PageHeroMedia.astro";

interface Props {
  description: string;
  heroImage?: ImageMetadata;
  heroImageLarge?: ImageMetadata;
  heroAttribution?: string;
  kicker: string;
  title: string;
}

const {
  description,
  heroAttribution,
  heroImage,
  heroImageLarge,
  kicker,
  title,
} = Astro.props;
const hasHeroImage = heroImage !== undefined || heroImageLarge !== undefined;
const resolvedHeroImage = heroImage ?? heroImageLarge;
---

<PageHero>
  {
    hasHeroImage && resolvedHeroImage !== undefined && (
      <PageHeroMedia
        slot="media"
        image={resolvedHeroImage}
        imageLarge={heroImageLarge ?? heroImage}
        attribution={heroAttribution}
      />
    )
  }
  <p
    class="page-hero__kicker font-display tracking-display m-0 mb-2 text-xl leading-normal font-bold uppercase"
  >
    {kicker}
  </p>
  <h1 class="page-hero__title font-display m-0 mb-6 break-words uppercase">
    {title}
  </h1>
  <p
    class="page-hero__description m-0 border-l-4 border-white pl-3 font-medium"
  >
    {description}
  </p>
</PageHero>
