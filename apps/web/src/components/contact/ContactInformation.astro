---
import * as messages from "../../paraglide/messages.js";
import type { PublicationCatalog } from "../../lib/content/publication";
import type { Locale } from "../../lib/content/primitives";
import ContactDataList from "../ContactDataList.astro";
import PageSection from "../PageSection.astro";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
}

const { catalog, locale } = Astro.props;
const contact = catalog.contact;
---

{
  contact && (
    <PageSection
      id="contact-information-title"
      title={messages.contact_information_title({}, { locale })}
    >
      <ContactDataList contact={contact} locale={locale} />
    </PageSection>
  )
}
