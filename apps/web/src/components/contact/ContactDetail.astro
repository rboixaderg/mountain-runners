---
import * as messages from "../../paraglide/messages.js";
import type { PublicationCatalog } from "../../lib/content/publication";
import type { Locale } from "../../lib/content/primitives";
import PageIntro from "../PageIntro.astro";
import ContactInformation from "./ContactInformation.astro";
import ContactNewsletter from "./ContactNewsletter.astro";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
}

const { catalog, locale } = Astro.props;
---

<article class="page-detail">
  <PageIntro
    kicker={messages.site_title({}, { locale })}
    title={messages.contact_page_title({}, { locale })}
    description={messages.contact_page_description({}, { locale })}
  />
  <ContactInformation catalog={catalog} locale={locale} />
  <ContactNewsletter catalog={catalog} locale={locale} />
</article>
