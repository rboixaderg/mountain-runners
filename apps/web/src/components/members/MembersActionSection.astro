---
import * as messages from "../../paraglide/messages.js";
import type { ExternalAction } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import { getExternalActionPresentation } from "../../lib/presentation/status";
import { externalLinkAttributes } from "../../lib/presentation/urls";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../../lib/analytics/catalog";

interface Props {
  action: ExternalAction | undefined;
  actionLabelKey: "members_federation_action" | "members_signup_action";
  introKey?: "members_signup_intro";
  locale: Locale;
  sectionId: string;
  titleKey: "members_federation_title" | "members_signup_title";
  variant?: "federation" | "signup";
}

const {
  action,
  actionLabelKey,
  introKey,
  locale,
  sectionId,
  titleKey,
  variant = "signup",
} = Astro.props;
const { href: actionHref, stateMessageKey } = getExternalActionPresentation(
  action,
  locale,
);
const actionAttributes = analyticsActionAttributes({
  action:
    variant === "federation"
      ? analyticsActions.federationSignup
      : analyticsActions.memberSignup,
  area: analyticsAreas.membersAction,
  target: variant,
});
---

<section
  class:list={[
    "members-action-card",
    "min-h-80",
    "p-6",
    "md:p-12",
    variant === "signup" && "bg-stone",
    variant === "federation" && "border-ink flex flex-col border-2 bg-white",
    `members-action-card--${variant}`,
  ]}
  aria-labelledby={sectionId}
>
  <div class="mb-6 flex items-center gap-2">
    <span class="bg-red h-6 w-2 shrink-0" aria-hidden="true"></span>
    <h2
      class="page-section__title font-display m-0 leading-none uppercase"
      id={sectionId}
    >
      {messages[titleKey]({}, { locale })}
    </h2>
  </div>
  <div
    class:list={[
      "page-section__body text-base",
      variant === "federation" && "flex flex-1 flex-col justify-end",
    ]}
  >
    {
      introKey !== undefined ? (
        <p class="m-0 mb-4 last:mb-0">{messages[introKey]({}, { locale })}</p>
      ) : null
    }
    {
      actionHref !== undefined ? (
        <a
          class:list={[
            "members-action__link",
            "border-ink text-ink hover:bg-ink inline-flex w-fit max-w-full items-center self-start border-2 px-4 text-xs leading-normal font-bold whitespace-nowrap uppercase no-underline hover:text-white",
            variant === "signup" && "mt-6",
            variant === "federation" &&
              "members-action__link--federation border-red bg-red hover:border-ink hover:bg-ink text-white hover:text-white",
          ]}
          href={actionHref}
          {...externalLinkAttributes}
          {...actionAttributes}
        >
          {messages[actionLabelKey]({}, { locale })}
        </a>
      ) : stateMessageKey !== undefined ? (
        <p class="members-action__state text-muted mt-4 mb-0">
          {messages[stateMessageKey]({}, { locale })}
        </p>
      ) : null
    }
  </div>
</section>
