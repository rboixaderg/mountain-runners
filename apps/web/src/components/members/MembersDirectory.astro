---
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import { getMembersDirectoryEntities } from "../../lib/content/members";
import type { Locale } from "../../lib/content/primitives";
import type { PublicationCatalog } from "../../lib/content/publication";
import { getOrderedEntityLinks } from "../../lib/presentation/entities";
import * as messages from "../../paraglide/messages.js";
import ExternalLink from "../ExternalLink.astro";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
}

const { catalog, locale } = Astro.props;
const collaborators = getMembersDirectoryEntities(catalog, locale);
const collaboratorsWithImages = await Promise.all(
  collaborators.map(async (entity) => {
    const resource = entity.logo.resource;
    return {
      entity,
      href: getResourceHref(resource),
      primaryLink: getOrderedEntityLinks(entity.links ?? [])[0],
      size:
        resource.kind === "local"
          ? await getLocalImageSize(resource.path)
          : undefined,
    };
  }),
);
---

{
  collaboratorsWithImages.length > 0 && (
    <section
      class="page-frame members-section"
      aria-labelledby="members-collaborators-title"
    >
      <div class="members-section__heading">
        <span class="members-section__marker" aria-hidden="true" />
        <h2 class="members-section__title" id="members-collaborators-title">
          {messages.members_collaborators_title({}, { locale })}
        </h2>
      </div>
      <ul class="members-directory">
        {collaboratorsWithImages.map(({ entity, href, primaryLink, size }) => (
          <li class="members-directory__entry">
            <img
              class="members-directory__logo"
              src={href}
              alt={entity.logo.alt[locale]}
              {...(size === undefined
                ? {}
                : { width: size.width, height: size.height })}
            />
            <div class="members-directory__content">
              <h3 class="members-directory__name">{entity.name[locale]}</h3>
              <p class="members-directory__benefit">
                <strong>{entity.membershipBenefit!.title[locale]}</strong>
              </p>
              <div
                class="members-directory__description"
                set:html={renderRestrictedMarkdown(
                  entity.membershipBenefit!.description[locale]!,
                )}
              />
              {primaryLink && (
                <ExternalLink
                  className="members-directory__website"
                  href={primaryLink.url}
                  label={entity.name[locale]!}
                />
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .members-directory__description :global(p) {
    margin: 0 0 var(--space-2);
  }

  .members-directory__description :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
