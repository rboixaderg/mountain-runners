---
import * as messages from "../../paraglide/messages.js";
import socisPortada from "../../assets/members/socis-portada.jpg";
import socisServeis from "../../assets/members/socis-serveis.jpg";
import { externalActionIds } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import type { PublicationCatalog } from "../../lib/content/publication";
import MembersActionSection from "./MembersActionSection.astro";
import MembersDirectory from "./MembersDirectory.astro";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
}

const { catalog, locale } = Astro.props;
const signupAction = catalog.externalActions.get(
  externalActionIds.memberSignup,
);
const federationAction = catalog.externalActions.get(
  externalActionIds.federation,
);
---

<article class="members-detail">
  <section class="page-frame members-intro">
    <figure class="members-intro__photo">
      <img
        src={socisPortada.src}
        width={socisPortada.width}
        height={socisPortada.height}
        alt={messages.members_intro_photo_alt({}, { locale })}
      />
      <figcaption>
        {messages.members_intro_photo_attribution({}, { locale })}
      </figcaption>
    </figure>
    <p class="members-intro__kicker">{messages.site_title({}, { locale })}</p>
    <h1>{messages.navigation_members({}, { locale })}</h1>
    <p class="members-intro__description">
      {messages.members_page_description({}, { locale })}
    </p>
  </section>

  <div
    class="page-frame members-actions grid gap-6 py-[var(--section-space)] md:grid-cols-2 md:gap-12"
  >
    <MembersActionSection
      action={signupAction}
      actionLabelKey="members_signup_action"
      introKey="members_signup_intro"
      locale={locale}
      sectionId="members-signup-title"
      titleKey="members_signup_title"
    />
    <MembersActionSection
      action={federationAction}
      actionLabelKey="members_federation_action"
      introKey="members_federation_intro"
      locale={locale}
      sectionId="members-federation-title"
      titleKey="members_federation_title"
    />
  </div>

  <section
    class="page-frame members-section"
    aria-labelledby="members-benefits-title"
  >
    <div class="members-section__heading">
      <span class="members-section__marker" aria-hidden="true"></span>
      <h2 class="members-section__title" id="members-benefits-title">
        {messages.members_benefits_title({}, { locale })}
      </h2>
    </div>
    <p class="members-section__body">
      {messages.members_benefits_intro({}, { locale })}
    </p>
    <figure class="members-benefits__photo">
      <img
        src={socisServeis.src}
        width={socisServeis.width}
        height={socisServeis.height}
        alt={messages.members_benefits_photo_alt({}, { locale })}
      />
    </figure>
  </section>

  <MembersDirectory catalog={catalog} locale={locale} />
</article>
