---
import * as messages from "../../paraglide/messages.js";
import type { Locale } from "../../lib/content/primitives";
import { youtubeVideoIds } from "../../lib/presentation/youtube";
import YoutubeEmbed from "../YoutubeEmbed.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  class="members-video"
  aria-label={messages.members_video_title({}, { locale })}
>
  <div class="page-frame members-video__inner">
    <figure class="members-video__figure">
      <YoutubeEmbed
        className="members-video__embed"
        title={messages.members_video_title({}, { locale })}
        videoId={youtubeVideoIds.membersPromotional}
      />
      <figcaption class="members-video__attribution">
        {messages.members_intro_photo_attribution({}, { locale })}
      </figcaption>
    </figure>
  </div>
</section>
