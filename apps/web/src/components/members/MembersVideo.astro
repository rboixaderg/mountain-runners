---
import * as messages from "../../paraglide/messages.js";
import type { Locale } from "../../lib/content/primitives";
import { extractYoutubeVideoId } from "../../lib/presentation/youtube";
import YoutubeEmbed from "../YoutubeEmbed.astro";

interface Props {
  locale: Locale;
  videoUrl?: string;
}

const { locale, videoUrl } = Astro.props;
const videoId = videoUrl ? extractYoutubeVideoId(videoUrl) : undefined;
---

{
  videoId !== undefined && (
    <section
      class="border-line bg-stone py-section border-b"
      aria-label={messages.members_video_title({}, { locale })}
    >
      <div class="page-frame flex justify-center">
        <figure class="max-w-reading m-0 w-full">
          <YoutubeEmbed
            className="shadow-action-lg"
            title={messages.members_video_title({}, { locale })}
            videoId={videoId}
          />
        </figure>
      </div>
    </section>
  )
}
