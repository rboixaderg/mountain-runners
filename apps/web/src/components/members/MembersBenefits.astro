---
import * as messages from "../../paraglide/messages.js";
import socisServeis from "../../assets/members/socis-serveis.jpg";
import type { Locale } from "../../lib/content/primitives";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../../lib/analytics/catalog";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const collaboratorsAnchorAttributes = analyticsActionAttributes({
  action: analyticsActions.anchorJump,
  area: analyticsAreas.membersCollaborators,
  target: "collaborators",
});
---

<section
  class="members-benefits bg-ink py-section w-full max-w-none text-white"
  aria-labelledby="members-benefits-title"
>
  <div class="page-frame members-benefits__inner grid">
    <div class="mb-8 flex items-center gap-2">
      <span class="bg-red h-6 w-2 shrink-0" aria-hidden="true"></span>
      <h2
        class="page-section__title font-display m-0 leading-none uppercase"
        id="members-benefits-title"
      >
        {messages.members_benefits_title({}, { locale })}
      </h2>
    </div>

    <div class="members-benefits__layout grid items-center">
      <div class="members-benefits__copy grid min-w-0">
        <p class="members-benefits__intro leading-copy m-0 max-w-2xl">
          {messages.members_benefits_intro({}, { locale })}
        </p>
        <a
          class="members-benefits__collaborators-link font-display text-action text-red-on-dark tracking-display font-bold uppercase underline hover:text-white"
          href="#members-collaborators-title"
          {...collaboratorsAnchorAttributes}
        >
          {messages.members_benefits_collaborators_link({}, { locale })}
        </a>
      </div>

      <figure class="members-benefits__photo m-0 justify-self-center">
        <img
          class="block w-full"
          src={socisServeis.src}
          width={socisServeis.width}
          height={socisServeis.height}
          alt={messages.members_benefits_photo_alt({}, { locale })}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>
