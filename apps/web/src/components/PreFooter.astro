---
import * as messages from "../paraglide/messages.js";
import { getLocalImageSize, getResourceHref } from "../lib/content/images";
import { newsletterActionId } from "../lib/content/models";
import type { Locale } from "../lib/content/primitives";
import type { PublicationCatalog } from "../lib/content/publication";
import { getSponsorEntities } from "../lib/content/sponsors";
import { getOrderedEntityLinks } from "../lib/presentation/entities";
import { getNewsletterPresentation } from "../lib/presentation/newsletter";
import {
  externalLinkAttributes,
  getMailtoHref,
  getTelHref,
} from "../lib/presentation/urls";
import { analyticsActionAttributes } from "../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../lib/analytics/catalog";
import "../styles/prefooter.css";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
}

const { catalog, locale } = Astro.props;
const contact = catalog.contact;
const newsletterPresentation = getNewsletterPresentation(
  catalog.externalActions.get(newsletterActionId),
  locale,
);
const emailInputId = "site-prefooter-newsletter-email";
const newsletterStatusMessage =
  newsletterPresentation === undefined
    ? messages.newsletter_unavailable({}, { locale })
    : newsletterPresentation.kind === "text"
      ? messages[newsletterPresentation.messageKey]({}, { locale })
      : null;
const newsletterStatusId =
  newsletterStatusMessage === null
    ? undefined
    : "site-prefooter-newsletter-status";
const officeHours = contact?.hours[locale]?.trim() ?? "";
const officeAddress = contact?.address[locale]?.trim() ?? "";
const showOfficeDetails = officeHours.length > 0;
const contactEmailAttributes = analyticsActionAttributes({
  action: analyticsActions.contactEmail,
  area: analyticsAreas.prefooterContact,
  target: "email",
});
const contactPhoneAttributes = analyticsActionAttributes({
  action: analyticsActions.contactPhone,
  area: analyticsAreas.prefooterContact,
  target: "phone",
});
const newsletterAttributes = analyticsActionAttributes({
  action: analyticsActions.newsletterSubscribe,
  area: analyticsAreas.prefooterNewsletter,
  target: "newsletter",
});
const sponsorItems = await Promise.all(
  getSponsorEntities(catalog, locale).map(async (entity) => {
    const resource = entity.logo.resource;
    return {
      entity,
      href: getResourceHref(resource),
      primaryLink: getOrderedEntityLinks(entity.links ?? [])[0],
      size:
        resource.kind === "local"
          ? await getLocalImageSize(resource.path)
          : undefined,
    };
  }),
);
---

<section
  class="border-line bg-stone border-t"
  aria-labelledby="site-prefooter-title"
>
  <div
    class="page-frame py-section grid gap-8 md:grid-cols-2 md:items-center md:gap-12"
  >
    <div class="site-prefooter__questions min-w-0 pl-4 md:pl-5">
      <h2
        class="text-red font-display tracking-display m-0 mb-4 leading-tight uppercase"
        id="site-prefooter-title"
      >
        {messages.prefooter_questions_title({}, { locale })}
      </h2>
      <p class="text-muted leading-copy m-0 mb-6 max-w-xl">
        {messages.prefooter_questions_description({}, { locale })}
      </p>
      {
        contact && (
          <ul class="m-0 grid list-none gap-3 p-0">
            {contact.email && (
              <li>
                <a
                  class="text-ink hover:text-red m-0 inline-flex items-start gap-2 leading-normal font-semibold decoration-2 underline-offset-2"
                  href={getMailtoHref(contact.email)}
                  {...contactEmailAttributes}
                >
                  <svg
                    class="text-red mt-0.5 size-5 shrink-0"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      fill="currentColor"
                      d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
                    />
                  </svg>
                  <span>{contact.email}</span>
                </a>
              </li>
            )}
            {contact.phones?.map((phone) => (
              <li>
                <a
                  class="text-ink hover:text-red m-0 inline-flex items-start gap-2 leading-normal font-semibold decoration-2 underline-offset-2"
                  href={getTelHref(phone)}
                  {...contactPhoneAttributes}
                >
                  <svg
                    class="text-red mt-0.5 size-5 shrink-0"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      fill="currentColor"
                      d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"
                    />
                  </svg>
                  <span>{phone}</span>
                </a>
              </li>
            ))}
            {showOfficeDetails && officeAddress.length > 0 && (
              <li>
                <p class="text-ink m-0 inline-flex cursor-default items-start gap-2 leading-normal font-semibold">
                  <svg
                    class="text-red mt-0.5 size-5 shrink-0"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      fill="currentColor"
                      d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                    />
                  </svg>
                  <span>{officeAddress}</span>
                </p>
              </li>
            )}
            {showOfficeDetails && (
              <li>
                <p class="text-ink m-0 inline-flex cursor-default items-start gap-2 leading-normal font-semibold">
                  <svg
                    class="text-red mt-0.5 size-5 shrink-0"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      fill="currentColor"
                      d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"
                    />
                  </svg>
                  <span>{officeHours}</span>
                </p>
              </li>
            )}
          </ul>
        )
      }
    </div>

    <div class="border-ink p-card min-w-0 border-2 bg-white">
      <h3
        class="site-prefooter__newsletter-title font-display tracking-display m-0 mb-4 leading-tight uppercase"
      >
        {messages.prefooter_newsletter_title({}, { locale })}
      </h3>
      <p class="text-muted leading-copy m-0 mb-4 max-w-xl text-sm">
        {messages.prefooter_newsletter_description({}, { locale })}
      </p>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-stretch">
        <label class="sr-only" for={emailInputId}>
          {messages.prefooter_newsletter_email_label({}, { locale })}
        </label>
        <input
          id={emailInputId}
          class="site-prefooter__newsletter-input border-line text-ink w-full min-w-0 border-2 bg-white px-3 py-2.5 text-sm leading-snug disabled:cursor-not-allowed disabled:opacity-70 sm:flex-1"
          type="email"
          autocomplete="email"
          placeholder={messages.prefooter_newsletter_email_placeholder(
            {},
            { locale },
          )}
          disabled
          {...newsletterStatusId === undefined
            ? {}
            : { "aria-describedby": newsletterStatusId }}
        />
        {
          newsletterPresentation?.kind === "link" ? (
            <a
              class="tracking-display leading-action bg-ink font-display hover:bg-red inline-flex items-center justify-center border-0 px-4 py-2.5 text-sm font-bold text-white uppercase no-underline transition-colors hover:text-white sm:shrink-0"
              href={newsletterPresentation.url}
              {...externalLinkAttributes}
              {...newsletterAttributes}
            >
              {messages.prefooter_newsletter_submit({}, { locale })}
            </a>
          ) : (
            <button
              class="tracking-display leading-action bg-ink font-display disabled:hover:bg-ink inline-flex items-center justify-center border-0 px-4 py-2.5 text-sm font-bold text-white uppercase transition-colors disabled:cursor-not-allowed disabled:opacity-55 sm:shrink-0"
              type="button"
              disabled
            >
              {messages.prefooter_newsletter_submit({}, { locale })}
            </button>
          )
        }
      </div>
      {
        newsletterStatusMessage !== null && (
          <p
            class="text-muted m-0 mt-3 text-sm leading-normal"
            id={newsletterStatusId}
          >
            {newsletterStatusMessage}
          </p>
        )
      }
    </div>
  </div>
  {
    sponsorItems.length > 0 && (
      <div class="page-frame border-line border-t">
        <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-x-10 gap-y-6 p-0 py-8">
          {sponsorItems.map(({ entity, href, primaryLink, size }) => {
            const logo = (
              <img
                class="max-h-14 w-auto max-w-40"
                src={href}
                alt={entity.logo.alt[locale]}
                {...(size === undefined
                  ? {}
                  : { width: size.width, height: size.height })}
                loading="lazy"
              />
            );
            return (
              <li>
                {primaryLink ? (
                  <a
                    class="inline-flex items-center"
                    href={primaryLink.url}
                    {...externalLinkAttributes}
                    {...analyticsActionAttributes({
                      action: analyticsActions.navigate,
                      area: analyticsAreas.prefooterSponsors,
                      target: entity.id,
                    })}
                  >
                    {logo}
                  </a>
                ) : (
                  logo
                )}
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</section>
