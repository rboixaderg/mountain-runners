---
import homepageHero from "../../assets/home/homepage-hero.jpeg";
import homepageHeroSmall from "../../assets/home/homepage-hero-mobile.jpeg";
import * as messages from "../../paraglide/messages.js";
import type { PublicationCatalog } from "../../lib/content/publication";
import type { Locale } from "../../lib/content/primitives";
import { getDocumentGroups } from "../../lib/presentation/documents";
import PageIntro from "../PageIntro.astro";
import DocumentGroup from "./DocumentGroup.astro";
import "../../styles/documents.css";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
}

const { catalog, locale } = Astro.props;
const documentGroups = getDocumentGroups(
  [...catalog.documents.values()],
  locale,
);
---

<article class="pb-0">
  <PageIntro
    description={messages.documents_page_description({}, { locale })}
    heroImage={homepageHeroSmall}
    heroImageLarge={homepageHero}
    kicker={messages.site_title({}, { locale })}
    title={messages.documents_page_title({}, { locale })}
  />
  {
    documentGroups.length > 0 ? (
      documentGroups.map(({ documentType, documents }) => (
        <DocumentGroup
          documentType={documentType}
          documents={documents}
          locale={locale}
        />
      ))
    ) : (
      <section class="page-frame py-section border-line border-b">
        <p class="page-section__body leading-copy m-0 text-base">
          {messages.documents_empty({}, { locale })}
        </p>
      </section>
    )
  }
</article>
