---
import * as messages from "../../paraglide/messages.js";
import { getDocumentHref } from "../../lib/content/images";
import type { Document } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import { formatCalendarDate } from "../../lib/presentation/dates";
import {
  getDocumentAvailabilityMessageKey,
  resourceLocaleMessageKeys,
} from "../../lib/presentation/documents";
import ExternalLink from "../ExternalLink.astro";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import {
  analyticsActions,
  analyticsAreas,
  sanitizeAnalyticsTarget,
} from "../../lib/analytics/catalog";

interface Props {
  document: Document;
  locale: Locale;
}

const { document, locale } = Astro.props;
const documentHref = getDocumentHref(document);
const availabilityMessageKey = getDocumentAvailabilityMessageKey(
  document.availability,
);
const resourceLocaleMessageKey =
  document.resourceLocale === undefined
    ? undefined
    : resourceLocaleMessageKeys[document.resourceLocale];
// Only the Catalan variant of the fixed pages is published today, so the
// required Catalan title is always present in the rendered locale.
const documentTitle = document.title[locale]!;
const documentAttributes = analyticsActionAttributes({
  action: analyticsActions.documentOpen,
  area: analyticsAreas.documents,
  target: sanitizeAnalyticsTarget(document.id),
});
---

<li class="documents-entry">
  <p class="documents-entry__title">
    {
      documentHref !== undefined ? (
        document.resource.kind === "external" ? (
          <ExternalLink
            href={documentHref}
            label={documentTitle}
            analyticsArea={analyticsAreas.documents}
            analyticsAction={analyticsActions.documentOpen}
            analyticsTarget={document.id}
          />
        ) : (
          <a href={documentHref} {...documentAttributes}>
            {documentTitle}
          </a>
        )
      ) : (
        <>
          {documentTitle}
          {availabilityMessageKey !== undefined && (
            <span class="documents-entry__state">
              {messages[availabilityMessageKey]({}, { locale })}
            </span>
          )}
        </>
      )
    }
  </p>
  <p class="documents-entry__description">
    {document.description[locale]}
  </p>
  {
    (document.date !== undefined ||
      resourceLocaleMessageKey !== undefined ||
      document.attribution !== undefined) && (
      <dl class="documents-entry__meta">
        {document.date !== undefined && (
          <div>
            <dt>{messages.document_date_label({}, { locale })}</dt>
            <dd>{formatCalendarDate(document.date, locale)}</dd>
          </div>
        )}
        {resourceLocaleMessageKey !== undefined && (
          <div>
            <dt>{messages.document_language_label({}, { locale })}</dt>
            <dd>{messages[resourceLocaleMessageKey]({}, { locale })}</dd>
          </div>
        )}
        {document.attribution !== undefined && (
          <div>
            <dt>{messages.document_attribution_label({}, { locale })}</dt>
            <dd>{document.attribution[locale]}</dd>
          </div>
        )}
      </dl>
    )
  }
</li>
