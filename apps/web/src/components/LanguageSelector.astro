---
import * as messages from "../paraglide/messages.js";
import type { Locale } from "../lib/content/primitives";
import { analyticsActionAttributes } from "../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../lib/analytics/catalog";

type LocalizedAlternative = { locale: Locale; href: string };

interface Props {
  localizedAlternatives: LocalizedAlternative[];
  locale: Locale;
}

const { localizedAlternatives, locale } = Astro.props;
const languageNames: Record<Locale, string> = {
  ca: messages.language_ca({}, { locale }),
  es: messages.language_es({}, { locale }),
  en: messages.language_en({}, { locale }),
};
---

{
  localizedAlternatives.length > 1 && (
    <nav aria-label={messages.language_selector({}, { locale })}>
      <details class="language-selector__details group relative">
        <summary
          class="language-selector__summary border-ink text-ink font-display hover:border-red hover:bg-red group-open:border-red group-open:bg-red block cursor-pointer list-none border-2 p-0 text-xs leading-none font-bold group-open:text-white hover:text-white"
          aria-label={`${messages.language_selector({}, { locale })}: ${languageNames[locale]}`}
        >
          <span class="language-selector__toggle inline-flex min-h-10 items-center">
            <svg
              class="language-selector__icon size-4 fill-none stroke-current"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18M12 3c2.3 2.5 3.5 5.5 3.5 9s-1.2 6.5-3.5 9c-2.3-2.5-3.5-5.5-3.5-9S9.7 5.5 12 3Z" />
            </svg>
            <span>{locale.toUpperCase()}</span>
            <span class="language-selector__chevron" aria-hidden="true" />
          </span>
        </summary>
        <ul class="language-selector__panel border-ink absolute right-0 m-0 min-w-44 list-none border-2 bg-white py-2">
          {localizedAlternatives.map((alternative) => (
            <li>
              {alternative.locale === locale ? (
                <span
                  class="language-selector__option bg-stone text-red font-display block w-full border-0 px-4 text-left text-xs font-bold uppercase no-underline"
                  aria-current="page"
                >
                  {languageNames[alternative.locale]}
                </span>
              ) : (
                <a
                  class="language-selector__option text-ink font-display hover:bg-stone hover:text-red block w-full border-0 bg-transparent px-4 text-left text-xs font-bold uppercase no-underline"
                  href={alternative.href}
                  hreflang={alternative.locale}
                  {...analyticsActionAttributes({
                    action: analyticsActions.localeSwitch,
                    area: analyticsAreas.languageSelector,
                    target: alternative.locale,
                  })}
                >
                  {languageNames[alternative.locale]}
                </a>
              )}
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}
