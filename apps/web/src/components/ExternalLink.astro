---
import {
  externalLinkAttributes,
  getExternalHost,
} from "../lib/presentation/urls";

interface Props {
  className?: string;
  href: string;
  label: string;
}

const { className, href, label } = Astro.props;
---

<a class={className} href={href} {...externalLinkAttributes}>
  {label} · {getExternalHost(href)}{" "}
  <span aria-hidden="true">→</span>
</a>
