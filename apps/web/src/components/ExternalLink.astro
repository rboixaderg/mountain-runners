---
import {
  externalLinkAttributes,
  getExternalHost,
} from "../lib/presentation/urls";

interface Props {
  className?: string;
  href: string;
  label: string;
  showHost?: boolean;
}

const { className, href, label, showHost = true } = Astro.props;
let linkText = label;
if (showHost) {
  linkText = `${label} · ${getExternalHost(href)}`;
}
---

<a class={className} href={href} {...externalLinkAttributes}>
  {linkText}{" "}
  <span aria-hidden="true">→</span>
</a>
