---
import * as messages from "../../paraglide/messages.js";
import { getDocumentHref } from "../../lib/content/images";
import { statutesDocumentId } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import type { PublicationCatalog } from "../../lib/content/publication";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../../lib/analytics/catalog";
import PageSection from "../PageSection.astro";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
}

const { catalog, locale } = Astro.props;
const statutesDocument = catalog.documents.get(statutesDocumentId);
const statutesHref = getDocumentHref(statutesDocument);
const statutesTitle = statutesDocument?.title[locale];
const statutesAttributes = analyticsActionAttributes({
  action: analyticsActions.documentOpen,
  area: analyticsAreas.aboutStatutes,
  target: "statutes",
});
---

<PageSection
  id="about-statutes-title"
  title={messages.about_statutes_title({}, { locale })}
  bordered={false}
  constrainBody={false}
>
  {
    statutesHref && statutesDocument && statutesTitle ? (
      <div class="about-statutes__card border-line p-card max-w-reading grid gap-4 border">
        <p class="leading-copy m-0 text-base">
          {messages.about_statutes_description({}, { locale })}
        </p>
        <a
          class="font-display text-ink hover:text-red tracking-display text-sm font-bold uppercase underline"
          href={statutesHref}
          {...statutesAttributes}
        >
          {statutesTitle}
        </a>
      </div>
    ) : (
      <p class="page-section__body max-w-reading text-base">
        {messages.about_statutes_unavailable({}, { locale })}
      </p>
    )
  }
</PageSection>
