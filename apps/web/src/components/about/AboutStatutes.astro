---
import { getDocumentHref } from "../../lib/content/images";
import { statutesDocumentId } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import type { PublicationCatalog } from "../../lib/content/publication";
import * as messages from "../../paraglide/messages.js";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
}

const { catalog, locale } = Astro.props;
const statutesDocument = catalog.documents.get(statutesDocumentId);
const statutesHref = getDocumentHref(statutesDocument);
const statutesTitle = statutesDocument?.title[locale];
---

<section
  class="page-frame about-section about-section--statutes"
  aria-labelledby="about-statutes-title"
>
  <div class="about-section__heading">
    <span class="about-section__marker" aria-hidden="true"></span>
    <h2 class="about-section__title" id="about-statutes-title">
      {messages.about_statutes_title({}, { locale })}
    </h2>
  </div>

  {
    statutesHref && statutesDocument && statutesTitle ? (
      <div class="about-statutes__card">
        <p class="about-statutes__description">
          {messages.about_statutes_description({}, { locale })}
        </p>
        <a class="about-statutes__link" href={statutesHref}>
          {statutesTitle}
        </a>
      </div>
    ) : (
      <p class="about-section__body">
        {messages.about_statutes_unavailable({}, { locale })}
      </p>
    )
  }
</section>
