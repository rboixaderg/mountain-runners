---
import * as messages from "../../paraglide/messages.js";
import boardPhoto from "../../assets/junta-directiva.jpg";
import type { Locale } from "../../lib/content/primitives";
import { parseBoardMembers } from "../../lib/presentation/about";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const boardMembers = parseBoardMembers(
  messages.about_board_members({}, { locale }),
);
---

<section
  class="page-frame page-section py-section about-section--dark border-line bg-ink max-w-none border-b text-white"
  aria-labelledby="about-board-title"
>
  <div class="mb-8 flex items-center gap-2">
    <span class="bg-red h-6 w-2 shrink-0" aria-hidden="true"></span>
    <h2
      class="page-section__title font-display m-0 leading-none uppercase"
      id="about-board-title"
    >
      {messages.about_board_title({}, { locale })}
    </h2>
  </div>

  <div class="about-board__layout grid items-start">
    <figure class="about-board__photo m-0 w-full max-w-3xs">
      <img
        class="block w-full border-2 border-white/35"
        src={boardPhoto.src}
        width={boardPhoto.width}
        height={boardPhoto.height}
        alt={messages.about_board_photo_alt({}, { locale })}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <ul class="about-board__list m-0 grid list-none gap-0 p-0">
      {
        boardMembers.map((member) => (
          <li class="about-board__member flex items-center justify-between gap-4 max-md:flex-col max-md:items-start">
            <span class="about-board__member-name font-display font-bold uppercase">
              {member.name}
            </span>
            <span class="about-board__member-role grid shrink-0 text-right max-md:text-left">
              <span class="about-board__role-label font-bold tracking-widest uppercase">
                {messages.about_board_role_label({}, { locale })}
              </span>
              <span>{member.role}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
