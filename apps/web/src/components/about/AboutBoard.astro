---
import * as messages from "../../paraglide/messages.js";
import boardPhoto from "../../assets/junta-directiva.jpg";
import type { Locale } from "../../lib/content/primitives";
import { parseBoardMembers } from "../../lib/presentation/about";
import PageSection from "../PageSection.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const boardMembers = parseBoardMembers(
  messages.about_board_members({}, { locale }),
);
---

<PageSection
  id="about-board-title"
  title={messages.about_board_title({}, { locale })}
  class="bg-ink text-white"
  constrainBody={false}
>
  <div
    class="about-board__layout grid items-start gap-6 md:items-center md:gap-12"
  >
    <figure class="m-0 w-full max-w-3xs">
      <img
        class="block w-full border-2 border-white/35 contrast-110 grayscale"
        src={boardPhoto.src}
        width={boardPhoto.width}
        height={boardPhoto.height}
        alt={messages.about_board_photo_alt({}, { locale })}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <ul class="m-0 grid list-none gap-0 border-t border-white/25 p-0">
      {
        boardMembers.map((member) => (
          <li class="flex items-center justify-between gap-4 border-b border-white/20 py-5 max-md:flex-col max-md:items-start">
            <span class="about-board__member-name font-display font-bold uppercase">
              {member.name}
            </span>
            <span class="grid shrink-0 gap-1 text-right max-md:text-left">
              <span class="text-meta tracking-label font-bold text-white/55 uppercase">
                {messages.about_board_role_label({}, { locale })}
              </span>
              <span>{member.role}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</PageSection>
