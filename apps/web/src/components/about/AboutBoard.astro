---
import boardPhoto from "../../assets/junta-directiva.jpg";
import type { Locale } from "../../lib/content/primitives";
import { parseBoardMembers } from "../../lib/presentation/about";
import * as messages from "../../paraglide/messages.js";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const boardMembers = parseBoardMembers(
  messages.about_board_members({}, { locale }),
);
---

<section
  class="page-frame about-section about-section--dark"
  aria-labelledby="about-board-title"
>
  <div class="about-section__heading">
    <span class="about-section__marker" aria-hidden="true"></span>
    <h2 class="about-section__title" id="about-board-title">
      {messages.about_board_title({}, { locale })}
    </h2>
  </div>

  <div class="about-board__layout">
    <figure class="about-board__photo">
      <img
        src={boardPhoto.src}
        width={boardPhoto.width}
        height={boardPhoto.height}
        alt={messages.about_board_photo_alt({}, { locale })}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <ul class="about-board__list">
      {
        boardMembers.map((member) => (
          <li class="about-board__member">
            <span class="about-board__member-name">{member.name}</span>
            <span class="about-board__member-role">
              <span class="about-board__role-label">
                {messages.about_board_role_label({}, { locale })}
              </span>
              <span>{member.role}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
