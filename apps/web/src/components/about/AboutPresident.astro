---
import * as messages from "../../paraglide/messages.js";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { Locale } from "../../lib/content/primitives";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  class="page-frame about-section"
  aria-labelledby="about-president-title"
>
  <div class="about-section__heading">
    <span class="about-section__marker" aria-hidden="true"></span>
    <h2 class="about-section__title" id="about-president-title">
      {messages.about_president_title({}, { locale })}
    </h2>
  </div>
  <div
    class="about-section__body"
    set:html={renderRestrictedMarkdown(
      messages.about_president_message({}, { locale }),
    )}
  />
  <p class="about-section__signature">
    {messages.about_president_signature({}, { locale })}
  </p>
</section>
