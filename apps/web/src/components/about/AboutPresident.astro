---
import * as messages from "../../paraglide/messages.js";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { Locale } from "../../lib/content/primitives";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  class="page-frame about-section border-line border-b"
  aria-labelledby="about-president-title"
>
  <div class="about-section__heading mb-8 flex items-center gap-2">
    <span
      class="about-section__marker bg-red h-6 w-2 shrink-0"
      aria-hidden="true"></span>
    <h2
      class="about-section__title font-display m-0 leading-none uppercase"
      id="about-president-title"
    >
      {messages.about_president_title({}, { locale })}
    </h2>
  </div>
  <div
    class="about-section__body text-base"
    set:html={renderRestrictedMarkdown(
      messages.about_president_message({}, { locale }),
    )}
  />
  <p class="about-section__signature font-display m-0 mt-4 font-bold uppercase">
    {messages.about_president_signature({}, { locale })}
  </p>
</section>
