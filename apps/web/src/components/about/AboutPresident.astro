---
import * as messages from "../../paraglide/messages.js";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { Locale } from "../../lib/content/primitives";
import PageSection from "../PageSection.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<PageSection
  id="about-president-title"
  title={messages.about_president_title({}, { locale })}
>
  <div
    set:html={renderRestrictedMarkdown(
      messages.about_president_message({}, { locale }),
    )}
  />
  <p
    class="about-section__signature font-display tracking-display m-0 mt-4 font-bold uppercase"
  >
    {messages.about_president_signature({}, { locale })}
  </p>
</PageSection>
