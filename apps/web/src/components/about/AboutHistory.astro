---
import * as messages from "../../paraglide/messages.js";
import aboutHistory from "../../assets/about/about-history.jpg";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { Locale } from "../../lib/content/primitives";
import PageSection from "../PageSection.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<PageSection
  id="about-history-title"
  title={messages.about_history_title({}, { locale })}
  constrainBody={false}
>
  <div class="about-history__grid grid items-start gap-6 md:gap-12">
    <div
      class="page-section__body max-w-reading text-base"
      set:html={renderRestrictedMarkdown(
        messages.about_history({}, { locale }),
      )}
    />
    <figure class="m-0 w-full max-w-3xs">
      <img
        class="border-ink block max-h-80 w-full border-2 object-cover object-center"
        src={aboutHistory.src}
        width={aboutHistory.width}
        height={aboutHistory.height}
        alt={messages.about_history_photo_alt({}, { locale })}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</PageSection>
