---
import * as messages from "../../paraglide/messages.js";
import aboutHero from "../../assets/about/about-hero.jpg";
import type { Locale } from "../../lib/content/primitives";
import type { PublicationCatalog } from "../../lib/content/publication";
import PageIntro from "../PageIntro.astro";
import AboutBoard from "./AboutBoard.astro";
import AboutHistory from "./AboutHistory.astro";
import AboutPresident from "./AboutPresident.astro";
import AboutStatutes from "./AboutStatutes.astro";
import "../../styles/about.css";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
}

const { catalog, locale } = Astro.props;
---

<article class="about-detail pb-0">
  <PageIntro
    description={messages.about_page_description({}, { locale })}
    heroImage={aboutHero}
    kicker={messages.site_title({}, { locale })}
    title={messages.navigation_about({}, { locale })}
  />

  <AboutHistory locale={locale} />
  <AboutPresident locale={locale} />
  <AboutBoard locale={locale} />
  <AboutStatutes catalog={catalog} locale={locale} />
</article>
