---
import "../styles/page-section.css";

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section class="page-frame page-section" aria-labelledby={id}>
  <div class="page-section__heading">
    <span class="page-section__marker" aria-hidden="true"></span>
    <h2 class="page-section__title" id={id}>{title}</h2>
  </div>
  <div class="page-section__body"><slot /></div>
</section>

<style>
  .page-section__body :global(.page-section__markdown p) {
    max-width: var(--reading-width);
    margin: 0 0 var(--space-4);
    font-size: 1rem;
    line-height: 1.6;
  }

  .page-section__body :global(.page-section__markdown p:last-child) {
    margin-bottom: 0;
  }
</style>
