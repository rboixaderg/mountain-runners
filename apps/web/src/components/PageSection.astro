---
import "../styles/page-section.css";

interface Props {
  id: string;
  title: string;
  class?: string;
  bordered?: boolean;
  constrainBody?: boolean;
}

const {
  id,
  title,
  class: className,
  bordered = true,
  constrainBody = true,
} = Astro.props;
---

<section
  class:list={[
    "page-frame py-section",
    bordered && "border-line border-b",
    className,
  ]}
  aria-labelledby={id}
>
  <div class="mb-8 flex items-center gap-2">
    <span class="bg-red h-6 w-2 shrink-0" aria-hidden="true"></span>
    <h2
      class="page-section__title font-display tracking-display m-0 leading-none uppercase"
      id={id}
    >
      {title}
    </h2>
  </div>
  {
    constrainBody ? (
      <div class="page-section__body leading-copy m-0 text-base">
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</section>
