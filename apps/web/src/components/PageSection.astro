---
import "../styles/page-section.css";

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section
  class="page-frame page-section py-section border-line border-b"
  aria-labelledby={id}
>
  <div class="mb-8 flex items-center gap-2">
    <span class="bg-red h-6 w-2 shrink-0" aria-hidden="true"></span>
    <h2
      class="page-section__title font-display m-0 leading-none uppercase"
      id={id}
    >
      {title}
    </h2>
  </div>
  <div class="page-section__body m-0 text-base"><slot /></div>
</section>

<style>
  .page-section__body :global(.page-section__markdown p) {
    max-width: var(--reading-width);
    margin: 0 0 var(--space-4);
    font-size: 1rem;
    line-height: 1.6;
  }

  .page-section__body :global(.page-section__markdown p:last-child) {
    margin-bottom: 0;
  }
</style>
