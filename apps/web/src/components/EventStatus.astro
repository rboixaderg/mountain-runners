---
import type { Locale } from "../lib/content/primitives";
import type { EventStatusMessageKey } from "../lib/presentation/status";
import * as messages from "../paraglide/messages.js";

interface Props {
  className?: string;
  locale: Locale;
  statusKey: EventStatusMessageKey;
}

const { className, locale, statusKey } = Astro.props;
const label = messages[statusKey]({}, { locale });
---

<span class={className}>{label}</span>
