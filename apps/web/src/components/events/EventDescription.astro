---
import * as messages from "../../paraglide/messages.js";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { Event } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";

interface Props {
  event: Event;
  locale: Locale;
}

const { event, locale } = Astro.props;
const description = event.description[locale];
const coverHref = getResourceHref(event.cover.resource);
const coverSize =
  event.cover.resource.kind === "local"
    ? await getLocalImageSize(event.cover.resource.path)
    : undefined;
---

{
  description !== undefined && description.trim().length > 0 && (
    <section
      class="page-frame events-detail__description grid items-center"
      aria-labelledby="event-description-title"
    >
      <div class="min-w-0">
        <h2
          id="event-description-title"
          class="events-detail__description-title font-display m-0 mb-5 uppercase"
        >
          {messages.event_description_title({}, { locale })}
        </h2>
        <div
          class="events-detail__description-body text-ink"
          set:html={renderRestrictedMarkdown(description)}
        />
      </div>
      {coverHref && (
        <figure class="events-detail__description-media relative mx-auto my-0 md:m-0 md:justify-self-end">
          <div
            class="bg-red absolute right-5 -bottom-5 -left-5 z-0 h-full"
            aria-hidden="true"
          />
          <div class="border-ink relative z-1 rotate-2 overflow-hidden border-2 bg-white p-2">
            <img
              class="block aspect-square w-full object-contain"
              src={coverHref}
              alt={event.cover.alt[locale]!}
              loading="lazy"
              decoding="async"
              {...(coverSize === undefined
                ? {}
                : { width: coverSize.width, height: coverSize.height })}
            />
          </div>
        </figure>
      )}
    </section>
  )
}

<style>
  .events-detail__description-body :global(:first-child) {
    margin-top: 0;
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 500;
  }

  .events-detail__description-body :global(:last-child) {
    margin-bottom: 0;
  }

  .events-detail__description-body :global(p + p) {
    margin-top: 1rem;
  }
</style>
