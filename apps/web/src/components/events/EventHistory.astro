---
import * as messages from "../../paraglide/messages.js";
import type { EventEdition } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import EditionDates from "../EditionDates.astro";

interface Props {
  editions: EventEdition[];
  locale: Locale;
}

const { editions, locale } = Astro.props;
---

{
  editions.length > 0 && (
    <section class="events-detail__history border-ink max-w-reading mx-0 mb-6 border-t-2 pt-6 first:mt-0">
      <h2 class="font-display m-0 mb-4 leading-none uppercase">
        {messages.event_previous_editions({}, { locale })}
      </h2>
      <ol class="m-0 pl-5">
        {editions.map((edition) => (
          <li class="my-2">
            <EditionDates edition={edition} locale={locale} />
            {` · ${edition.location[locale]}`}
          </li>
        ))}
      </ol>
    </section>
  )
}
