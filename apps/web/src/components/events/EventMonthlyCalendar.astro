---
import * as messages from "../../paraglide/messages.js";
import type { Event } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import {
  buildCalendarMonthGrid,
  getCalendarFocusMonth,
} from "../../lib/presentation/events";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../../lib/analytics/catalog";
import "../../styles/events-calendar.css";

interface Props {
  events: readonly Event[];
  locale: Locale;
  resolveEventHref: (event: Event) => string;
  today: string;
}

const { events, locale, resolveEventHref, today } = Astro.props;
const focusMonth = getCalendarFocusMonth(events, today);
const calendar = buildCalendarMonthGrid(
  events,
  focusMonth.year,
  focusMonth.month,
  locale,
  today,
  resolveEventHref,
);
---

<section
  class="events-calendar page-frame"
  aria-labelledby="events-calendar-title"
  data-events-calendar
>
  <div class="events-hub-section__heading mb-7 flex items-center gap-2">
    <span
      class="events-hub-section__marker bg-red h-6 w-2 shrink-0"
      aria-hidden="true"></span>
    <h2
      id="events-calendar-title"
      class="events-hub-section__title font-display m-0 leading-none uppercase"
    >
      {messages.events_calendar_title({}, { locale })}
    </h2>
  </div>

  <div class="events-calendar__panel border-line bg-paper border">
    <table class="events-calendar__table w-full table-fixed border-collapse">
      <caption
        class="events-calendar__caption border-line font-display caption-top border-b px-6 py-5 text-left font-bold capitalize"
      >
        {calendar.monthLabel}
      </caption>
      <thead>
        <tr>
          {
            calendar.weekdayLabels.map((weekdayLabel) => (
              <th
                scope="col"
                class="events-calendar__weekday border-line font-display text-muted border-b px-2 text-center font-bold uppercase"
              >
                {weekdayLabel}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          calendar.weeks.map((week) => (
            <tr>
              {week.map((day) => {
                const hasEvents = day.events.length > 0;
                const dayLabel =
                  day.dayNumber === null
                    ? undefined
                    : hasEvents
                      ? messages.events_calendar_day_with_events(
                          {
                            day: day.dayNumber,
                            events: day.events
                              .map((event) => event.title)
                              .join(", "),
                          },
                          { locale },
                        )
                      : String(day.dayNumber);
                const popoverId =
                  day.date === null
                    ? undefined
                    : `events-calendar-popover-${day.date}`;

                return (
                  <td
                    class:list={[
                      "events-calendar__day border-line bg-paper relative h-18 border-r border-b p-0 text-center align-middle max-md:h-13",
                      !day.isCurrentMonth &&
                        "events-calendar__day--outside text-muted",
                      hasEvents && "events-calendar__day--has-events",
                      day.isMultiDay && "events-calendar__day--multi-day",
                      day.isRangeStart && "events-calendar__day--range-start",
                      day.isRangeMiddle && "events-calendar__day--range-middle",
                      day.isRangeEnd && "events-calendar__day--range-end",
                    ]}
                  >
                    {day.dayNumber !== null && hasEvents ? (
                      <>
                        <button
                          type="button"
                          class="events-calendar__day-button grid size-full cursor-pointer place-items-center border-0 bg-transparent p-0 text-inherit"
                          aria-controls={popoverId}
                          aria-expanded="false"
                          aria-label={dayLabel}
                          {...analyticsActionAttributes({
                            action: analyticsActions.calendarDayOpen,
                            area: analyticsAreas.eventCalendar,
                            target: day.date ?? "unknown",
                          })}
                        >
                          <span
                            class:list={[
                              "events-calendar__day-number font-display relative z-1 inline-grid size-8 place-items-center font-bold",
                              day.isToday && "border-ink border-2",
                            ]}
                          >
                            {day.dayNumber}
                          </span>
                          <span
                            class="events-calendar__day-mark bg-red absolute rounded-full"
                            aria-hidden="true"
                          />
                        </button>
                        <div
                          id={popoverId}
                          class="events-calendar__popover"
                          role="region"
                          aria-label={messages.events_calendar_popover_label(
                            {},
                            { locale },
                          )}
                        >
                          {day.events.map((event) => (
                            <article class="events-calendar__event">
                              <h3 class="events-calendar__event-title font-display m-0 mb-2 font-bold uppercase">
                                {event.title}
                              </h3>
                              <dl class="events-calendar__event-meta">
                                <div>
                                  <dt class="text-muted font-bold uppercase">
                                    {messages.event_dates_label({}, { locale })}
                                  </dt>
                                  <dd class="m-0">{event.dateLabel}</dd>
                                </div>
                                <div>
                                  <dt class="text-muted font-bold uppercase">
                                    {messages.event_location_label(
                                      {},
                                      { locale },
                                    )}
                                  </dt>
                                  <dd class="m-0">{event.location}</dd>
                                </div>
                              </dl>
                              <a
                                class="events-calendar__event-link text-ink hover:text-red font-bold uppercase underline"
                                href={event.href}
                                {...analyticsActionAttributes({
                                  action: analyticsActions.calendarEventLink,
                                  area: analyticsAreas.eventCalendar,
                                  target: event.id,
                                })}
                              >
                                {messages.event_more_information(
                                  {},
                                  { locale },
                                )}
                              </a>
                            </article>
                          ))}
                        </div>
                      </>
                    ) : (
                      day.dayNumber !== null && (
                        <span
                          class:list={[
                            "events-calendar__day-number font-display relative z-1 inline-grid size-8 place-items-center font-bold",
                            day.isToday && "border-ink border-2",
                          ]}
                        >
                          {day.dayNumber}
                        </span>
                      )
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<script>
  function closeCalendarPopovers(calendar: HTMLElement) {
    for (const day of calendar.querySelectorAll(
      ".events-calendar__day--open",
    )) {
      day.classList.remove("events-calendar__day--open");
      const button = day.querySelector(".events-calendar__day-button");
      button?.setAttribute("aria-expanded", "false");
    }
  }

  function openCalendarDay(day: HTMLElement) {
    const button = day.querySelector(".events-calendar__day-button");
    if (button === null) return;

    day.classList.add("events-calendar__day--open");
    button.setAttribute("aria-expanded", "true");
  }

  for (const calendarElement of document.querySelectorAll(
    "[data-events-calendar]",
  )) {
    if (!(calendarElement instanceof HTMLElement)) continue;
    const calendar = calendarElement;

    calendar.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest(".events-calendar__day-button");
      if (button === null) return;

      const day = button.closest(".events-calendar__day--has-events");
      if (day === null || !(day instanceof HTMLElement)) return;

      event.stopPropagation();
      const isOpen = day.classList.contains("events-calendar__day--open");
      closeCalendarPopovers(calendar);
      if (!isOpen) {
        openCalendarDay(day);
      }
    });
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest("[data-events-calendar]") !== null) return;

    for (const calendar of document.querySelectorAll(
      "[data-events-calendar]",
    )) {
      if (calendar instanceof HTMLElement) {
        closeCalendarPopovers(calendar);
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    for (const calendar of document.querySelectorAll(
      "[data-events-calendar]",
    )) {
      if (calendar instanceof HTMLElement) {
        closeCalendarPopovers(calendar);
      }
    }
  });
</script>
