---
import * as messages from "../../paraglide/messages.js";
import type { Event, EventEdition } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import EditionDates from "../EditionDates.astro";
import EventPracticalIcon from "./EventPracticalIcon.astro";

interface Props {
  edition: EventEdition | undefined;
  event: Event;
  hasAnnouncedDate: boolean;
  locale: Locale;
}

const { edition, event, hasAnnouncedDate, locale } = Astro.props;

// The page derives whether the active event has an announced next edition;
// this section only decides how to present the data it receives.
const modalities = edition?.modalities ?? [];
const hasModalities = modalities.length > 0;
---

{
  edition && (
    <section
      class="events-detail__edition bg-ink m-0 w-full border-0 p-0 text-white shadow-none"
      aria-label={messages.event_practical_info({}, { locale })}
    >
      <div class="page-frame events-detail__edition-inner">
        <h2 class="font-display m-0 mb-8 flex items-center gap-3 leading-none text-white uppercase">
          {messages.event_practical_info({}, { locale })}
        </h2>
        <dl class="m-0 grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="border-red flex min-h-36 flex-col border-l-4 p-6">
            <dt class="font-display mb-2 flex items-center gap-3 font-bold text-white uppercase">
              <span class="text-red flex shrink-0" aria-hidden="true">
                <EventPracticalIcon field="dates" />
              </span>
              {messages.event_dates_label({}, { locale })}
            </dt>
            <dd class="events-detail__dates m-0 text-base font-medium">
              {event.active && !hasAnnouncedDate ? (
                <span>{messages.event_no_date_announced({}, { locale })}</span>
              ) : (
                <EditionDates edition={edition} locale={locale} />
              )}
            </dd>
          </div>
          <div class="border-red flex min-h-36 flex-col border-l-4 p-6">
            <dt class="font-display mb-2 flex items-center gap-3 font-bold text-white uppercase">
              <span class="text-red flex shrink-0" aria-hidden="true">
                <EventPracticalIcon field="location" />
              </span>
              {messages.event_location_label({}, { locale })}
            </dt>
            <dd class="m-0 text-base font-medium">
              {edition.location[locale]}
            </dd>
          </div>
          {hasModalities && (
            <div class="border-red flex min-h-36 flex-col border-l-4 p-6">
              <dt class="font-display mb-2 flex items-center gap-3 font-bold text-white uppercase">
                <span class="text-red flex shrink-0" aria-hidden="true">
                  <EventPracticalIcon field="modalities" />
                </span>
                {messages.event_modalities_label({}, { locale })}
              </dt>
              <dd class="m-0 text-base font-medium">
                <ul class="events-detail__modalities m-0 flex list-none flex-wrap p-0">
                  {modalities.map((modality) => (
                    <li class="border-0 p-0 text-base font-medium tracking-normal normal-case">
                      {modality[locale]}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      </div>
    </section>
  )
}
