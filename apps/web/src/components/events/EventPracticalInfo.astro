---
import { getNextEdition } from "../../lib/content/events";
import type { Event, EventEdition } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import * as messages from "../../paraglide/messages.js";
import EditionDates from "../EditionDates.astro";
import EventPracticalIcon from "./EventPracticalIcon.astro";

interface Props {
  edition: EventEdition | undefined;
  event: Event;
  locale: Locale;
  today: string;
}

const { edition, event, locale, today } = Astro.props;

// An active event without a next edition shows "no date announced" instead of
// the previous edition's dates, so the practical info never looks stale.
const nextEdition = getNextEdition(event, today);
const hasAnnouncedDate = nextEdition !== undefined;
const modalities = edition?.modalities ?? [];
const hasModalities = modalities.length > 0;
---

{
  edition && (
    <section
      class="events-detail__edition"
      aria-label={messages.event_practical_info({}, { locale })}
    >
      <div class="page-frame events-detail__edition-inner">
        <h2>{messages.event_practical_info({}, { locale })}</h2>
        <dl>
          <div>
            <dt>
              <span class="events-detail__practical-icon" aria-hidden="true">
                <EventPracticalIcon field="dates" />
              </span>
              {messages.event_dates_label({}, { locale })}
            </dt>
            <dd class="events-detail__dates">
              {event.active && !hasAnnouncedDate ? (
                <span>{messages.event_no_date_announced({}, { locale })}</span>
              ) : (
                <EditionDates edition={edition} locale={locale} />
              )}
            </dd>
          </div>
          <div>
            <dt>
              <span class="events-detail__practical-icon" aria-hidden="true">
                <EventPracticalIcon field="location" />
              </span>
              {messages.event_location_label({}, { locale })}
            </dt>
            <dd>{edition.location[locale]}</dd>
          </div>
          {hasModalities && (
            <div>
              <dt>
                <span class="events-detail__practical-icon" aria-hidden="true">
                  <EventPracticalIcon field="modalities" />
                </span>
                {messages.event_modalities_label({}, { locale })}
              </dt>
              <dd>
                <ul class="events-detail__modalities">
                  {modalities.map((modality) => (
                    <li>{modality[locale]}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      </div>
    </section>
  )
}
