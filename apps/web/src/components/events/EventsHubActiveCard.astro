---
import * as messages from "../../paraglide/messages.js";
import type { Event } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import type { PublishedVariant } from "../../lib/content/publication";
import { getVariantPath } from "../../lib/content/routes";
import { getEventHubStatusMessageKey } from "../../lib/presentation/status";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../../lib/analytics/catalog";
import EventStatus from "../EventStatus.astro";

interface Props {
  event: Event;
  locale: Locale;
  today: string;
  variant: Extract<PublishedVariant, { kind: "event" }>;
}

const { event, locale, today, variant } = Astro.props;
const statusKey = getEventHubStatusMessageKey(
  event,
  undefined,
  "active-without-date",
  today,
);
const summary = event.summary[locale];
const eventLinkAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsAreas.eventsHub,
  target: event.id,
});
---

<li class="border-line border-b">
  <a
    class="hover:bg-red/5 flex items-center justify-between gap-4 px-4 py-6 text-inherit no-underline max-md:flex-col max-md:items-start"
    href={getVariantPath(variant)}
    {...eventLinkAttributes}
  >
    <span class="events-hub-active-item__body grid min-w-0 gap-1.5">
      <strong class="font-display leading-none uppercase"
        >{event.title[locale]}</strong
      >
      {
        summary && (
          <span class="text-muted text-sm leading-normal">{summary}</span>
        )
      }
    </span>
    <span class="grid flex-none gap-1 text-right max-md:text-left">
      <span class="text-muted text-meta tracking-label font-bold uppercase">
        {messages.events_active_status_label({}, { locale })}
      </span>
      <EventStatus
        className="text-muted text-xs leading-normal font-semibold"
        locale={locale}
        statusKey={statusKey}
      />
    </span>
  </a>
</li>
