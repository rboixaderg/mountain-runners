---
import * as messages from "../../paraglide/messages.js";
import type { Document, EventEdition } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import type { RegistrationPresentation } from "../../lib/presentation/status";
import EventResources from "./EventResources.astro";
import ExternalLink from "../ExternalLink.astro";

interface Props {
  documents: { id: string; document: Document | undefined }[];
  edition: EventEdition | undefined;
  informationUrl: string | undefined;
  locale: Locale;
  registration: RegistrationPresentation;
}

const { documents, edition, informationUrl, locale, registration } =
  Astro.props;

const hasResources = edition !== undefined && documents.length > 0;
const hasInformationLink = informationUrl !== undefined;
const showPanel = edition !== undefined;
---

{
  showPanel && (
    <section
      class="page-frame events-detail__actions"
      aria-label={messages.event_actions_region({}, { locale })}
    >
      <div
        class:list={[
          "events-detail__actions-grid",
          !hasInformationLink && "events-detail__actions-grid--single",
        ]}
      >
        {hasInformationLink && (
          <article class="events-detail__action-card events-detail__action-card--info">
            <h2 class="events-detail__action-title">
              {messages.event_more_information({}, { locale })}
            </h2>
            <p class="events-detail__action-intro">
              {messages.event_information_intro({}, { locale })}
            </p>
            <ExternalLink
              className="event-action"
              href={informationUrl!}
              label={messages.event_more_information({}, { locale })}
            />
          </article>
        )}
        <article class="events-detail__action-card events-detail__action-card--registration">
          <h2 class="events-detail__action-title">
            {messages.event_registration_title({}, { locale })}
          </h2>
          <p class="events-detail__action-intro">
            {messages.event_registration_intro({}, { locale })}
          </p>
          <p class="events-detail__registration-status">
            <span>{messages[registration.key]({}, { locale })}</span>
          </p>
          {registration.url && registration.actionKey && (
            <ExternalLink
              className="event-action event-action--registration"
              href={registration.url}
              label={messages[registration.actionKey]({}, { locale })}
            />
          )}
        </article>
      </div>
      {hasResources && (
        <EventResources
          documents={documents}
          edition={edition}
          locale={locale}
        />
      )}
    </section>
  )
}
