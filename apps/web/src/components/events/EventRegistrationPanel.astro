---
import * as messages from "../../paraglide/messages.js";
import type { Document, EventEdition } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import type { RegistrationPresentation } from "../../lib/presentation/status";
import EventResources from "./EventResources.astro";
import ExternalLink from "../ExternalLink.astro";
import { analyticsActions, analyticsAreas } from "../../lib/analytics/catalog";

interface Props {
  documents: { id: string; document: Document | undefined }[];
  edition: EventEdition | undefined;
  informationUrl: string | undefined;
  locale: Locale;
  registration: RegistrationPresentation;
}

const { documents, edition, informationUrl, locale, registration } =
  Astro.props;

const hasResources = edition !== undefined && documents.length > 0;
const hasInformationLink = informationUrl !== undefined;
const showPanel = edition !== undefined;
---

{
  showPanel && (
    <section
      class="page-frame events-detail__actions border-ink border-t-2"
      aria-label={messages.event_actions_region({}, { locale })}
    >
      <div
        class:list={[
          "grid grid-cols-1 gap-5",
          !hasInformationLink && "mx-auto max-w-xl",
          hasInformationLink && "md:grid-cols-2",
        ]}
      >
        {hasInformationLink && (
          <article class="events-detail__action-card--info border-ink p-card shadow-action grid content-start gap-4 border-2 bg-white">
            <h2 class="events-detail__action-title font-display m-0 leading-none uppercase">
              {messages.event_more_information({}, { locale })}
            </h2>
            <p class="events-detail__action-intro text-muted m-0 max-w-md leading-normal">
              {messages.event_information_intro({}, { locale })}
            </p>
            <ExternalLink
              className="event-action shadow-action tracking-display inline-flex items-center justify-self-start gap-1.5 border-2 border-ink bg-white px-5 py-action text-xs font-bold text-ink no-underline uppercase hover:bg-ink hover:text-white"
              href={informationUrl!}
              label={messages.event_more_information({}, { locale })}
              analyticsArea={analyticsAreas.eventActions}
              analyticsAction={analyticsActions.eventInformation}
              analyticsTarget="information"
            />
          </article>
        )}
        <article class="events-detail__action-card--registration border-ink p-card grid content-start gap-4 border-2 text-center text-white">
          <h2 class="events-detail__action-title font-display m-0 leading-none text-white uppercase italic">
            {messages.event_registration_title({}, { locale })}
          </h2>
          <p class="events-detail__action-intro m-0 max-w-md justify-self-center leading-normal text-white/80">
            {messages.event_registration_intro({}, { locale })}
          </p>
          <p class="text-action tracking-label m-0 font-bold text-white uppercase">
            <span>{messages[registration.key]({}, { locale })}</span>
          </p>
          {registration.url && registration.actionKey && (
            <ExternalLink
              className="event-action shadow-action tracking-display inline-flex items-center justify-self-center gap-1.5 border-2 border-red bg-red px-5 py-action text-xs font-bold text-white no-underline uppercase hover:bg-white hover:text-ink"
              href={registration.url}
              label={messages[registration.actionKey]({}, { locale })}
              analyticsArea={analyticsAreas.eventActions}
              analyticsAction={analyticsActions.eventRegistration}
              analyticsTarget="registration"
            />
          )}
        </article>
      </div>
      {hasResources && (
        <EventResources
          documents={documents}
          edition={edition}
          locale={locale}
        />
      )}
    </section>
  )
}
