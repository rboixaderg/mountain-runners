---
import * as messages from "../../paraglide/messages.js";
import {
  getMostRelevantEdition,
  getPreviousEditions,
  getRegistrationUrl,
} from "../../lib/content/events";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import { renderRestrictedMarkdown } from "../../lib/content/markdown";
import type { Locale } from "../../lib/content/primitives";
import type {
  PublishedVariant,
  PublicationCatalog,
} from "../../lib/content/publication";
import {
  getEventActivityMessageKey,
  getRegistrationPresentation,
} from "../../lib/presentation/status";
import EventEntities from "./EventEntities.astro";
import EventHistory from "./EventHistory.astro";
import EventPracticalInfo from "./EventPracticalInfo.astro";
import EventResources from "./EventResources.astro";
import EventStatus from "../EventStatus.astro";
import ExternalLink from "../ExternalLink.astro";
import "../../styles/event-detail.css";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
  today: string;
  variant: Extract<PublishedVariant, { kind: "event" }>;
}

const { catalog, locale, today, variant } = Astro.props;
const event = variant.entry;
const featuredEdition = getMostRelevantEdition(event, today);
const previousEditions = getPreviousEditions(event, today);
const registrationUrl =
  featuredEdition === undefined
    ? undefined
    : getRegistrationUrl(event, featuredEdition, locale);
const registration = getRegistrationPresentation(
  featuredEdition?.registrationStatus,
  registrationUrl,
);
const informationUrl = event.informationUrl?.[locale];
const coverHref = getResourceHref(event.cover.resource);
const coverSize =
  event.cover.resource.kind === "local"
    ? await getLocalImageSize(event.cover.resource.path)
    : undefined;
const relatedEntities = [
  ...event.organizerIds.map((id) => catalog.entities.get(id)),
  ...event.collaboratorIds.map((id) => catalog.entities.get(id)),
].filter((entity) => entity !== undefined);
const editionDocuments =
  featuredEdition?.documentIds.map((id) => ({
    id,
    document: catalog.documents.get(id),
  })) ?? [];
---

<article class="events-detail pb-0">
  <section
    class="events-detail__hero border-ink bg-ink relative grid aspect-[2.2/1] min-h-[clamp(20rem,32vw,28rem)] max-w-none place-items-center overflow-hidden border-y-[0.25rem] text-white"
  >
    {
      coverHref && (
        <figure class="bg-red absolute inset-0 grid place-items-center">
          <img
            class="h-auto max-h-[60%] w-[min(55%,28rem)] border-0 bg-transparent object-contain p-0 opacity-35"
            src={coverHref}
            alt={event.cover.alt[locale]}
            {...(coverSize === undefined
              ? {}
              : { width: coverSize.width, height: coverSize.height })}
          />
          {event.cover.attribution?.[locale] && (
            <figcaption class="text-paper absolute right-3 bottom-3 m-0 bg-[rgb(23_23_23_/_0.78)] px-2 py-1 text-[0.7rem]">
              {event.cover.attribution[locale]}
            </figcaption>
          )}
        </figure>
      )
    }
    <div
      class="page-frame events-detail__hero-copy relative z-[1] grid justify-items-center text-center"
    >
      <p
        class="events-detail__badge bg-ink font-display text-paper m-0 mb-4 inline-block px-2 py-1 text-[0.7rem] leading-tight font-bold tracking-[0.08em] uppercase"
      >
        {
          event.clubRelationship === "organizes"
            ? messages.event_club_badge_organizes({}, { locale })
            : messages.event_club_badge_collaborates({}, { locale })
        }
      </p>
      <EventStatus
        className="events-detail__editorial-status text-xs font-bold tracking-[0.08em] uppercase"
        locale={locale}
        statusKey={getEventActivityMessageKey(event.active)}
      />
      <h1
        class="events-detail__title font-display m-0 max-w-[13ch] text-[clamp(3.5rem,9vw,8.5rem)] leading-[0.88] tracking-[-0.035em] text-white uppercase italic"
      >
        {event.title[locale]}
      </h1>
    </div>
  </section>
  <EventPracticalInfo
    edition={featuredEdition}
    event={event}
    locale={locale}
    registration={registration}
    today={today}
  />
  <div class="page-frame events-detail__content">
    <section
      class="events-detail__description"
      set:html={renderRestrictedMarkdown(event.description[locale]!)}
    />
    {
      informationUrl && (
        <ExternalLink
          className="events-detail__info-link"
          href={informationUrl}
          label={messages.event_more_information({}, { locale })}
        />
      )
    }
    <EventResources
      documents={editionDocuments}
      edition={featuredEdition}
      locale={locale}
    />
    <EventHistory editions={previousEditions} locale={locale} />
    <EventEntities entities={relatedEntities} locale={locale} />
  </div>
</article>

<style>
  .events-detail__description :global(:first-child) {
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 500;
  }
</style>
