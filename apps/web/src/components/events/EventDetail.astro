---
import {
  getMostRelevantEdition,
  getPreviousEditions,
  getRegistrationUrl,
} from "../../lib/content/events";
import { getLocalImageSize, getResourceHref } from "../../lib/content/images";
import { institutionalEntityId } from "../../lib/content/members";
import type { Locale } from "../../lib/content/primitives";
import type {
  PublicationCatalog,
  PublishedVariant,
} from "../../lib/content/publication";
import {
  getEventActivityMessageKey,
  getRegistrationPresentation,
} from "../../lib/presentation/status";
import * as messages from "../../paraglide/messages.js";
import DetailHero from "../DetailHero.astro";
import EventStatus from "../EventStatus.astro";
import EventDescription from "./EventDescription.astro";
import EventEntities from "./EventEntities.astro";
import EventHistory from "./EventHistory.astro";
import EventPracticalInfo from "./EventPracticalInfo.astro";
import EventRegistrationPanel from "./EventRegistrationPanel.astro";
import "../../styles/event-detail.css";

interface Props {
  catalog: PublicationCatalog;
  locale: Locale;
  today: string;
  variant: Extract<PublishedVariant, { kind: "event" }>;
}

const { catalog, locale, today, variant } = Astro.props;
const event = variant.entry;
const featuredEdition = getMostRelevantEdition(event, today);
const previousEditions = getPreviousEditions(event, today);
const registrationUrl =
  featuredEdition === undefined
    ? undefined
    : getRegistrationUrl(event, featuredEdition, locale);
const registration = getRegistrationPresentation(
  featuredEdition?.registrationStatus,
  registrationUrl,
);
const informationUrl = event.informationUrl?.[locale];
const coverHref = getResourceHref(event.cover.resource);
const coverSize =
  event.cover.resource.kind === "local"
    ? await getLocalImageSize(event.cover.resource.path)
    : undefined;
const relatedEntities = [
  ...event.organizerIds.map((id) => catalog.entities.get(id)),
  ...event.collaboratorIds.map((id) => catalog.entities.get(id)),
].filter((entity) => entity !== undefined);
const editionDocuments =
  featuredEdition?.documentIds.map((id) => ({
    id,
    document: catalog.documents.get(id),
  })) ?? [];
---

<article class="events-detail pb-0">
  {
    coverHref && (
      <DetailHero
        coverAlt={event.cover.alt[locale]!}
        coverAttribution={event.cover.attribution?.[locale]}
        coverHeight={coverSize?.height}
        coverHref={coverHref}
        coverWidth={coverSize?.width}
        kicker={
          event.clubRelationship === "organizes"
            ? messages.event_club_badge_organizes({}, { locale })
            : messages.event_club_badge_collaborates({}, { locale })
        }
        title={event.title[locale]!}
      >
        <EventStatus
          slot="meta"
          className="detail-hero__meta"
          locale={locale}
          statusKey={getEventActivityMessageKey(event.active)}
        />
      </DetailHero>
    )
  }
  <EventPracticalInfo
    edition={featuredEdition}
    event={event}
    locale={locale}
    today={today}
  />
  <EventDescription event={event} locale={locale} />
  <EventRegistrationPanel
    documents={editionDocuments}
    edition={featuredEdition}
    informationUrl={informationUrl}
    locale={locale}
    registration={registration}
  />
  <div class="page-frame events-detail__content">
    <EventHistory editions={previousEditions} locale={locale} />
    <EventEntities
      entities={relatedEntities}
      institutionalEntityId={institutionalEntityId}
      locale={locale}
    />
  </div>
</article>
