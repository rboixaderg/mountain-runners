---
import * as messages from "../../paraglide/messages.js";
import type { Event, EventEdition } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import { getEditionDayMonth } from "../../lib/presentation/dates";
import { getHomepageEventStatusMessageKey } from "../../lib/presentation/status";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import {
  analyticsActions,
  type AnalyticsArea,
} from "../../lib/analytics/catalog";

interface Props {
  analyticsArea: AnalyticsArea;
  edition: EventEdition | undefined;
  event: Event;
  featured?: boolean;
  href: string;
  locale: Locale;
  today: string;
}

const {
  analyticsArea,
  edition,
  event,
  featured = false,
  href,
  locale,
  today,
} = Astro.props;
const statusKey = getHomepageEventStatusMessageKey(edition, today);
const status = messages[statusKey]({}, { locale });
const dateParts = getEditionDayMonth(edition, locale);
const eventLinkAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsArea,
  target: event.id,
});
---

<article class="border-line border-b">
  <a
    class="homepage-event__link group grid text-inherit no-underline"
    href={href}
    {...eventLinkAttributes}
  >
    <div
      class:list={[
        "homepage-event__date max-md:border-line grid place-items-center px-4 py-6 text-center max-md:row-span-2 max-md:border-r",
        featured && "bg-red text-paper",
      ]}
    >
      {
        edition ? (
          <time class="grid" datetime={edition.startDate}>
            <span class="font-display font-bold">{dateParts?.day}</span>
            <small
              class:list={[
                "font-display tracking-label mt-2 font-bold uppercase",
                featured ? "text-inherit" : "text-red",
              ]}
            >
              {dateParts?.month}
            </small>
          </time>
        ) : (
          <span class="font-display text-line font-bold" aria-hidden="true">
            --
          </span>
        )
      }
    </div>
    <div class="p-card grid content-center">
      <p class="m-0 mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
        <span
          class="bg-ink font-display text-meta text-paper tracking-label px-2 py-[0.2rem] font-bold uppercase"
          >{status}</span
        >
        {
          edition && (
            <span class="font-display text-meta text-red tracking-label font-bold uppercase">
              {edition.location[locale]}
            </span>
          )
        }
      </p>
      <h3
        class="font-display group-hover:text-red m-0 text-[clamp(1.75rem,3.4vw,2.75rem)] leading-none uppercase"
      >
        {event.title[locale]}
      </h3>
      {
        event.summary[locale] && (
          <p class="text-muted leading-copy mt-3 max-w-[46rem] text-[0.95rem]">
            {event.summary[locale]}
          </p>
        )
      }
    </div>
    <div
      class="md:border-line max-md:px-card max-md:pb-card grid place-items-center px-6 py-4 max-md:justify-items-start max-md:pt-0 md:border-l"
    >
      <span
        class="font-display text-ink group-hover:text-red action-underline tracking-label text-center text-xs leading-normal font-bold uppercase"
      >
        {messages.homepage_event_action({}, { locale })}
      </span>
    </div>
  </a>
</article>
