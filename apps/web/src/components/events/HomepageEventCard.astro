---
import * as messages from "../../paraglide/messages.js";
import type { Event, EventEdition } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import { getEditionDayMonth } from "../../lib/presentation/dates";
import { getHomepageEventStatusMessageKey } from "../../lib/presentation/status";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import {
  analyticsActions,
  type AnalyticsArea,
} from "../../lib/analytics/catalog";

interface Props {
  analyticsArea: AnalyticsArea;
  edition: EventEdition | undefined;
  event: Event;
  featured?: boolean;
  href: string;
  locale: Locale;
  today: string;
}

const {
  analyticsArea,
  edition,
  event,
  featured = false,
  href,
  locale,
  today,
} = Astro.props;
const statusKey = getHomepageEventStatusMessageKey(edition, today);
const status = messages[statusKey]({}, { locale });
const dateParts = getEditionDayMonth(edition, locale);
const eventLinkAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsArea,
  target: event.id,
});
---

<article class="homepage-event border-line border-b">
  <a
    class="homepage-event__link grid text-inherit no-underline"
    href={href}
    {...eventLinkAttributes}
  >
    <div
      class:list={[
        "homepage-event__date max-md:border-line grid place-items-center px-4 py-6 text-center max-md:row-span-2 max-md:border-r",
        featured && "bg-red text-paper",
      ]}
    >
      {
        edition ? (
          <time class="grid" datetime={edition.startDate}>
            <span class="font-display font-bold">{dateParts?.day}</span>
            <small
              class:list={[
                "font-display mt-2 font-bold uppercase",
                featured ? "text-inherit" : "text-red",
              ]}
            >
              {dateParts?.month}
            </small>
          </time>
        ) : (
          <span class="font-display text-line font-bold" aria-hidden="true">
            --
          </span>
        )
      }
    </div>
    <div
      class="homepage-event__body grid content-center p-[clamp(1.5rem,3vw,2.25rem)]"
    >
      <p
        class="homepage-event__meta m-0 mb-3 flex flex-wrap items-center gap-x-3 gap-y-2"
      >
        <span
          class="homepage-event__status bg-ink font-display text-paper px-2 py-[0.2rem] text-[0.7rem] leading-[1.4] font-bold tracking-[0.1em] uppercase"
          >{status}</span
        >
        {
          edition && (
            <span class="homepage-event__location font-display text-red text-[0.7rem] leading-[1.4] font-bold tracking-[0.1em] uppercase">
              {edition.location[locale]}
            </span>
          )
        }
      </p>
      <h3
        class="font-display m-0 text-[clamp(1.75rem,3.4vw,2.75rem)] leading-none uppercase"
      >
        {event.title[locale]}
      </h3>
      {
        event.summary[locale] && (
          <p class="homepage-event__description text-muted mt-3 max-w-[46rem] text-[0.95rem] leading-[1.6]">
            {event.summary[locale]}
          </p>
        )
      }
    </div>
    <div
      class="md:border-line grid place-items-center px-6 py-4 max-md:justify-items-start max-md:px-[clamp(1.5rem,3vw,2.25rem)] max-md:pt-0 max-md:pb-[clamp(1.5rem,3vw,2.25rem)] md:border-l"
    >
      <span
        class="homepage-event__action font-display text-ink text-center text-xs leading-normal font-bold tracking-[0.12em] uppercase underline decoration-[0.1rem] underline-offset-[0.3rem]"
      >
        {messages.homepage_event_action({}, { locale })}
      </span>
    </div>
  </a>
</article>
