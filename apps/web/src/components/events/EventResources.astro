---
import * as messages from "../../paraglide/messages.js";
import { externalLinkAttributes } from "../../lib/presentation/urls";
import { getDocumentHref } from "../../lib/content/images";
import type { Document, EventEdition } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";

interface Props {
  documents: { id: string; document: Document | undefined }[];
  edition: EventEdition | undefined;
  locale: Locale;
}

const { documents, edition, locale } = Astro.props;
---

{
  edition && documents.length > 0 && (
    <section class="events-detail__resources">
      <h2>{messages.event_resources_title({}, { locale })}</h2>
      <ul>
        {documents.map(({ id, document }) => {
          const documentHref = getDocumentHref(document);
          return (
            <li>
              {documentHref && document ? (
                <a
                  href={documentHref}
                  {...(document.resource.kind === "external"
                    ? externalLinkAttributes
                    : {})}
                >
                  {document.title[locale]}
                </a>
              ) : (
                <span>
                  {document?.title[locale] ?? id} —{" "}
                  {messages.event_resource_unavailable({}, { locale })}
                </span>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )
}
