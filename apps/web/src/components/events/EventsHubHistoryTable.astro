---
import * as messages from "../../paraglide/messages.js";
import type { EventHistoryRow } from "../../lib/presentation/events";
import type { Locale } from "../../lib/content/primitives";
import EventStatus from "../EventStatus.astro";
import { eventStatusMessageKeys } from "../../lib/presentation/status";
import { analyticsActionAttributes } from "../../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../../lib/analytics/catalog";

interface Props {
  locale: Locale;
  rows: readonly EventHistoryRow[];
}

const { locale, rows } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="events-hub-history__table w-full border-collapse text-left">
    <thead>
      <tr>
        <th
          scope="col"
          class="border-line font-display text-muted tracking-label border-b-2 px-3 py-4 text-xs leading-normal font-bold uppercase"
        >
          {messages.events_history_year({}, { locale })}
        </th>
        <th
          scope="col"
          class="border-line font-display text-muted tracking-label border-b-2 px-3 py-4 text-xs leading-normal font-bold uppercase"
        >
          {messages.events_history_event({}, { locale })}
        </th>
        <th
          scope="col"
          class="border-line font-display text-muted tracking-label border-b-2 px-3 py-4 text-xs leading-normal font-bold uppercase"
        >
          {messages.events_history_location({}, { locale })}
        </th>
        <th
          scope="col"
          class="border-line font-display text-muted tracking-label border-b-2 px-3 py-4 text-right text-xs leading-normal font-bold uppercase"
        >
          {messages.events_history_status({}, { locale })}
        </th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td class="text-muted px-3 py-4 text-sm">{row.year}</td>
            <td class="px-3 py-4 text-sm">
              <a
                class="font-display hover:text-red text-sm font-bold text-inherit uppercase no-underline"
                href={row.href}
                {...analyticsActionAttributes({
                  action: analyticsActions.navigate,
                  area: analyticsAreas.eventsHub,
                  target: row.id,
                })}
              >
                {row.title}
              </a>
            </td>
            <td class="px-3 py-4 text-sm">{row.location}</td>
            <td class="px-3 py-4 text-right text-sm">
              <EventStatus
                className="events-hub-history__status text-muted text-meta inline-block px-2 py-1 font-bold tracking-label uppercase"
                locale={locale}
                statusKey={eventStatusMessageKeys.historical}
              />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
