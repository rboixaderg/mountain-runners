---
import * as messages from "../../paraglide/messages.js";
import type { Entity } from "../../lib/content/models";
import type { Locale } from "../../lib/content/primitives";
import {
  entityLinkLabelMessageKeys,
  getOrderedEntityLinks,
} from "../../lib/presentation/entities";
import { externalLinkAttributes } from "../../lib/presentation/urls";
import EntityLinkIcon from "./EntityLinkIcon.astro";

interface Props {
  entities: Entity[];
  // Identifies the club itself so the section can hide when the club is the
  // only related entity of one of its own events.
  institutionalEntityId: string;
  locale: Locale;
}

const { entities, institutionalEntityId, locale } = Astro.props;

// The club always relates to its own events, so the list only adds value when
// another entity is involved.
const hasOtherEntities = entities.some(
  (entity) => entity.id !== institutionalEntityId,
);
---

{
  hasOtherEntities && (
    <section class="events-detail__entities border-ink max-w-reading mx-0 mb-6 border-t-2 pt-6 first:mt-0">
      <h2 class="font-display m-0 mb-4 leading-none uppercase">
        {messages.event_entities_title({}, { locale })}
      </h2>
      <ul class="m-0 pl-5">
        {entities.map((entity) => (
          <li class="my-2">
            <strong>{entity.name[locale]}</strong>
            <span class="ms-2 inline-flex items-center gap-2 align-middle">
              {getOrderedEntityLinks(entity.links ?? []).map((link) => (
                <a
                  class="text-red hover:text-ink inline-flex items-center"
                  href={link.url}
                  aria-label={`${messages[
                    entityLinkLabelMessageKeys[link.kind]
                  ]({}, { locale })} · ${entity.name[locale]}`}
                  {...externalLinkAttributes}
                >
                  <EntityLinkIcon kind={link.kind} />
                </a>
              ))}
            </span>
            {entity.attribution?.[locale] && (
              <p class="text-muted text-action m-0 mt-2">
                {entity.attribution[locale]}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
