---
import * as messages from "../paraglide/messages.js";
import type { Locale } from "../lib/content/primitives";
import { getDomainPath, getFixedPagePath } from "../lib/content/routes";
import { getSiteSocialLinks } from "../lib/presentation/social";
import { externalLinkAttributes } from "../lib/presentation/urls";
import { analyticsActionAttributes } from "../lib/analytics/attributes";
import { analyticsActions, analyticsAreas } from "../lib/analytics/catalog";
import "../styles/site-footer.css";

interface Props {
  instagramUrl?: string;
  locale: Locale;
  stravaClubUrl?: string;
}

const { instagramUrl, locale, stravaClubUrl } = Astro.props;
const siteSocialLinks = getSiteSocialLinks({ instagramUrl, stravaClubUrl });
const homePath = `/${locale}/`;
const eventsPath = getDomainPath("event", locale);
const documentsPath = getFixedPagePath("documents", locale);
const legalNoticePath = getFixedPagePath("legal-notice", locale);
const legalPrivacyPath = getFixedPagePath("legal-privacy", locale);
const legalCookiesPath = getFixedPagePath("legal-cookies", locale);
const homeNavAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsAreas.footerNav,
  target: "home",
});
const eventsNavAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsAreas.footerNav,
  target: "events",
});
const documentsNavAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsAreas.footerNav,
  target: "documents",
});
const legalNoticeNavAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsAreas.footerNav,
  target: "legal_notice",
});
const privacyNavAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsAreas.footerNav,
  target: "privacy",
});
const cookiesNavAttributes = analyticsActionAttributes({
  action: analyticsActions.navigate,
  area: analyticsAreas.footerNav,
  target: "cookies",
});
---

<footer class="site-footer bg-ink text-white">
  <div
    class="page-frame site-footer__grid grid gap-10 md:grid-cols-2 md:items-start"
  >
    <div class="min-w-0">
      <p class="site-footer__brand font-display m-0 mb-4 font-bold uppercase">
        {messages.site_title({}, { locale })}
      </p>
      <p class="site-footer__tagline m-0">
        {messages.homepage_community_description({}, { locale })}
      </p>
    </div>
    <nav
      class="min-w-0"
      aria-label={messages.footer_social_title({}, { locale })}
    >
      <p
        class="site-footer__section-title font-display m-0 mb-4 font-bold uppercase"
      >
        {messages.footer_social_title({}, { locale })}
      </p>
      <ul class="site-footer__social-list m-0 grid list-none p-0">
        {
          siteSocialLinks.map((socialLink) => (
            <li>
              <a
                class="site-footer__social-link inline-flex items-center gap-2 no-underline"
                href={socialLink.url}
                {...externalLinkAttributes}
                {...analyticsActionAttributes({
                  action: analyticsActions.socialLink,
                  area: analyticsAreas.footerSocial,
                  target: socialLink.id,
                })}
              >
                {socialLink.id === "instagram" && (
                  <svg
                    class="size-4.5 shrink-0"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      fill="currentColor"
                      d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6m9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10m0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"
                    />
                  </svg>
                )}
                {socialLink.id === "strava" && (
                  <svg
                    class="size-4.5 shrink-0"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      fill="currentColor"
                      d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.599h4.172L10.463 0l-7 13.828h4.169"
                    />
                  </svg>
                )}
                <span>
                  {messages[socialLink.labelMessageKey]({}, { locale })}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav
      class="min-w-0"
      aria-label={messages.footer_navigation({}, { locale })}
    >
      <ul class="footer-links m-0 grid list-none p-0">
        <li>
          <a href={homePath} {...homeNavAttributes}
            >{messages.navigation_home({}, { locale })}</a
          >
        </li>
        <li>
          <a href={eventsPath} {...eventsNavAttributes}
            >{messages.navigation_events({}, { locale })}</a
          >
        </li>
        <li>
          <a href={documentsPath} {...documentsNavAttributes}
            >{messages.documents_page_title({}, { locale })}</a
          >
        </li>
      </ul>
    </nav>
    <nav class="min-w-0" aria-label={messages.legal_navigation({}, { locale })}>
      <ul class="footer-links m-0 grid list-none p-0">
        <li>
          <a href={legalNoticePath} {...legalNoticeNavAttributes}
            >{messages.legal_notice_title({}, { locale })}</a
          >
        </li>
        <li>
          <a href={legalPrivacyPath} {...privacyNavAttributes}
            >{messages.legal_privacy_title({}, { locale })}</a
          >
        </li>
        <li>
          <a href={legalCookiesPath} {...cookiesNavAttributes}
            >{messages.legal_cookies_title({}, { locale })}</a
          >
        </li>
      </ul>
    </nav>
  </div>
  <div
    class="page-frame site-footer__bottom flex flex-wrap justify-center gap-3 py-6 text-xs leading-normal uppercase"
  >
    <span>{messages.site_title({}, { locale })}</span>
    <span aria-hidden="true">©</span>
    <span>{messages.legal_notice_title({}, { locale })}</span>
  </div>
</footer>
