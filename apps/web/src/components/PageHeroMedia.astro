---
import type { ImageMetadata } from "astro";

interface Props {
  className?: string;
  fetchpriority?: "high" | "low" | "auto";
  image: ImageMetadata;
  imageClassName?: string;
  imageLarge?: ImageMetadata;
  loading?: "eager" | "lazy";
}

const largeViewportQuery = "(min-width: 48rem)";

const {
  className,
  fetchpriority,
  image,
  imageClassName,
  imageLarge = image,
  loading = "lazy",
} = Astro.props;
const usesResponsiveSource = imageLarge.src !== image.src;
---

<picture slot="media" class:list={["page-hero__media", className]}>
  {
    usesResponsiveSource && (
      <source media={largeViewportQuery} srcset={imageLarge.src} />
    )
  }
  <img
    class:list={["page-hero__image", imageClassName]}
    src={image.src}
    width={image.width}
    height={image.height}
    loading={loading}
    fetchpriority={fetchpriority}
    alt=""
  />
</picture>
