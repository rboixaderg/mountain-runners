---
import type { ImageMetadata } from "astro";

interface Props {
  attribution?: string;
  className?: string;
  fetchpriority?: "high" | "low" | "auto";
  image: ImageMetadata;
  imageClassName?: string;
  imageLarge?: ImageMetadata;
  loading?: "eager" | "lazy";
}

const largeViewportQuery = "(min-width: 48rem)";

const {
  attribution,
  className,
  fetchpriority,
  image,
  imageClassName,
  imageLarge = image,
  loading = "lazy",
} = Astro.props;
const usesResponsiveSource = imageLarge.src !== image.src;
---

<figure
  slot="media"
  class:list={[
    "absolute inset-0 z-0 m-0 block h-full w-full max-w-none",
    className,
  ]}
>
  <picture class="block h-full w-full">
    {
      usesResponsiveSource && (
        <source media={largeViewportQuery} srcset={imageLarge.src} />
      )
    }
    <img
      class:list={[
        "h-full w-full object-cover opacity-25 mix-blend-multiply contrast-110 grayscale",
        imageClassName,
      ]}
      src={image.src}
      width={image.width}
      height={image.height}
      loading={loading}
      fetchpriority={fetchpriority}
      alt=""
    />
  </picture>
  {
    attribution && (
      <figcaption class="page-hero__attribution absolute right-3 bottom-3 z-1 m-0 bg-black/75 px-2 py-1 text-xs leading-tight text-white">
        {attribution}
      </figcaption>
    )
  }
</figure>
