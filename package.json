{
  "name": "mountain-runners",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.11.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "build": "pnpm --filter @mountain-runners/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @mountain-runners/web dev",
    "format": "biome check --write --files-ignore-unknown=true . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,yml,yaml}\"",
    "lighthouse": "PUBLIC_SITE_ORIGIN=https://mountainrunners.cat BUILD_TODAY=2026-08-04 pnpm build && node tools/lighthouse/run-lighthouse.mjs",
    "lint": "pnpm --filter @mountain-runners/web paraglide:generate && biome lint .",
    "prepare": "husky",
    "test": "pnpm --filter @mountain-runners/web test",
    "test:a11y": "PUBLIC_SITE_ORIGIN=https://mountainrunners.cat BUILD_TODAY=2026-08-04 pnpm build && playwright test --grep @a11y",
    "test:e2e": "PUBLIC_SITE_ORIGIN=https://mountainrunners.cat BUILD_TODAY=2026-08-04 pnpm build && playwright test",
    "typecheck": "pnpm --filter @mountain-runners/web typecheck",
    "validate": "pnpm check && pnpm test:e2e"
  },
  "lint-staged": {
    "*.{astro,css,js,mjs,ts,json}": "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched",
    "*.{md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "chrome-launcher": "1.2.1",
    "husky": "9.1.7",
    "lighthouse": "13.4.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
