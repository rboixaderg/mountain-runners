{
  "mcpServers": {
    "plausible": {
      "command": "node",
      "args": ["~/.local/share/plausible-mcp/dist/index.js"],
      "env": {
        "PLAUSIBLE_API_KEY": "${PLAUSIBLE_API_KEY}",
        "PLAUSIBLE_BASE_URL": "${PLAUSIBLE_BASE_URL}"
      },
      "exposure": "direct",
      "description": "Consulta les mètriques de Plausible. Les eines són només de lectura."
    }
  }
}
