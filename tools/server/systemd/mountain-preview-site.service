[Unit]
Description=Mountain Runners preview Caddy site manager
After=network.target caddy.service

[Service]
Type=simple
ExecStart=/usr/local/lib/mountain-runners/preview/processes/mountain-preview-site/main.mjs
Environment=MOUNTAIN_PREVIEW_SITE_GID=0
Environment=MOUNTAIN_PREVIEW_SITE_UID=0
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/caddy /run /var/lib/mountain-runners-previews/namespaces
# `caddy validate` opens the log files declared in the Caddyfile; private
# tmpfs mounts satisfy it without granting write access to the real logs.
TemporaryFileSystem=/var/log/mountain-runners /var/log/mountain-runners-previews

[Install]
WantedBy=multi-user.target
